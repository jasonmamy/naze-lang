// Naze Grammar (Phase 2 M8)
// Supports: app blocks, page blocks (routing), component definitions, use statements,
// spatial primitives (row/column/stack/grid/spacer), rect, text, heading,
// comments, properties with literals (string/number/color/bool/ref),
// let bindings (immutable), state declarations (mutable, reactive),
// string interpolation ({expr} in string literals),
// theme definitions (colors, spacing tokens), link elements

WHITESPACE = _{ " " | "\t" | "\r" }
NEWLINE_CHAR = _{ "\n" }

file = { SOI ~ (NEWLINE_CHAR | statement)* ~ EOI }

statement = _{ comment | use_stmt | function_def | component_def | template_def | app_block | page_block | theme_def | let_stmt | shared_state_stmt | state_stmt | computed_stmt | storage_stmt | data_stmt | timer_stmt | param_stmt | if_stmt | match_stmt | each_stmt | on_handler | slot_stmt | fill_stmt | link_element | element }

// -- Comments
comment = @{ "--" ~ (!NEWLINE_CHAR ~ ANY)* }

// -- Use statement: use components/toolbar
use_stmt = { "use" ~ use_path ~ NEWLINE_CHAR }
use_path = @{ ident_raw ~ ("/" ~ ident_raw)* }

// -- App block: app "Title" { ... }
app_block = { "app" ~ string_lit ~ block }

// -- Page block: page "/path" { ... }
page_block = { "page" ~ string_lit ~ block }

// -- Link element: link "text" to: "/path"
link_element = { "link" ~ string_lit ~ "," ~ "to" ~ ":" ~ string_lit ~ (block | NEWLINE_CHAR) }

// -- Component definition: component name(param: type = default) { ... }
component_def = { "component" ~ ident ~ param_list? ~ block }
param_list = { "(" ~ param ~ ("," ~ param)* ~ ")" }
param = { ident ~ ":" ~ type_name ~ ("=" ~ value)? }
type_name = { "text" | "number" | "bool" | "color" }

// -- Template definition: template name(slot-name, slot-name) { ... }
template_def = { "template" ~ ident ~ template_slot_list? ~ block }
template_slot_list = { "(" ~ ident ~ ("," ~ ident)* ~ ")" }

// -- Theme definition: theme { colors { ... } spacing { ... } }
theme_def = { "theme" ~ theme_block }
theme_block = { "{" ~ (NEWLINE_CHAR | theme_section)* ~ "}" }
theme_section = { theme_section_name ~ "{" ~ (NEWLINE_CHAR | theme_entry)* ~ "}" }
theme_section_name = { "colors" | "spacing" }
theme_entry = { ident ~ ":" ~ value ~ NEWLINE_CHAR? }

// -- Let binding (immutable, compile-time): let label = "Hello"
let_stmt = { "let" ~ ident ~ "=" ~ value ~ NEWLINE_CHAR }

// -- State declaration (mutable, reactive): state count = 0
state_stmt = { "state" ~ ident ~ "=" ~ value ~ NEWLINE_CHAR }

// -- Shared state declaration (persists across page navigation): shared state auth = null
shared_state_stmt = { "shared" ~ "state" ~ ident ~ "=" ~ value ~ NEWLINE_CHAR }

// -- Computed declaration (read-only derived state): computed total = count * price
// -- or with pipeline: computed total = cart | map price | sum
computed_stmt = { "computed" ~ ident ~ "=" ~ pipe_expression ~ NEWLINE_CHAR }

// -- Storage declaration (persistent state): storage theme: local "theme-pref" default: "light"
storage_stmt = { "storage" ~ ident ~ ":" ~ storage_type ~ string_lit ~ "default" ~ ":" ~ value ~ NEWLINE_CHAR }
storage_type = { "local" | "session" }

// -- Data declaration (async fetch or stream): data users: fetch "url" { ... } or data chat: stream "wss://..."
data_stmt = { "data" ~ ident ~ ":" ~ data_source ~ string_lit ~ (data_block | NEWLINE_CHAR) }
data_source = { "fetch" | "stream" | "js" | "device" }
data_block = { "{" ~ (NEWLINE_CHAR | data_prop)* ~ "}" }
data_prop = { data_prop_key ~ ":" ~ data_prop_value ~ NEWLINE_CHAR? }
data_prop_key = { "method" | "cache" | "retry" | "trigger" | "content-type" | "body" | "headers" | "watch" }
data_prop_value = _{ duration_lit | value }

// -- Timer declaration: timer toast-dismiss: after 5s { set show-toast = false }
timer_stmt = { "timer" ~ ident ~ ":" ~ timer_kind ~ duration_lit ~ "{" ~ (NEWLINE_CHAR)* ~ action ~ (NEWLINE_CHAR)* ~ "}" }
timer_kind = { "after" | "every" }

// -- URL param: param page: number default: 1
param_stmt = { "param" ~ ident ~ ":" ~ type_name ~ "default" ~ ":" ~ value ~ NEWLINE_CHAR }

// -- Event handler: on click: set count = count + 1, with optional debounce/throttle
on_handler = { "on" ~ event_name ~ event_modifier? ~ ":" ~ action ~ NEWLINE_CHAR }
event_name = { "click-outside" | "click" | "context-menu" | "pointer-move" | "arrow-up" | "arrow-down" | "arrow-left" | "arrow-right" | "hover" | "keypress" | "change" | "drag-start" | "drag-over" | "drop" | "scroll" }
event_modifier = { modifier_kind ~ duration_lit }
modifier_kind = { "debounce" | "throttle" }
action = _{ set_action | navigate_action | scroll_to_action | trigger_action | copy_action | send_action | log_action | js_action | notify_action }
set_action = { "set" ~ ident ~ "=" ~ expression }
navigate_action = { "navigate" ~ string_lit }
scroll_to_action = { "scroll-to" ~ string_lit }
trigger_action = { "trigger" ~ ident }
copy_action = { "copy" ~ expression }
send_action = { "send" ~ ident ~ expression }
log_action = { "log" ~ expression }
js_action = { "js" ~ string_lit ~ "(" ~ call_args? ~ ")" ~ ("->" ~ ident)? }
notify_action = { "notify" ~ string_lit ~ notify_block? }
notify_block = { "{" ~ (NEWLINE_CHAR | notify_prop)* ~ "}" }
notify_prop = { notify_prop_key ~ ":" ~ value ~ NEWLINE_CHAR? }
notify_prop_key = { "body" | "icon" }

// -- Conditional: if expr { ... } else { ... }
if_stmt = { "if" ~ expression ~ block ~ else_clause? }
else_clause = _{ "else" ~ (if_stmt | block) }

// -- Iteration: each item in list { ... }
// -- or with pipeline: each item in items | filter score > 80 | sort-by name { ... }
each_stmt = { "each" ~ ident ~ "in" ~ pipe_expression ~ block }

// -- Pure function definition: function name(param: type, ...) -> return_type { expression }
function_def = { "function" ~ ident ~ func_param_list ~ "->" ~ type_name ~ "{" ~ NEWLINE_CHAR* ~ pipe_expression ~ NEWLINE_CHAR* ~ "}" }
func_param_list = { "(" ~ func_param ~ ("," ~ func_param)* ~ ")" }
func_param = { ident ~ ":" ~ type_name }

// -- Pattern matching: match expr { pattern: children, ... }
match_stmt = { "match" ~ expression ~ "{" ~ (NEWLINE_CHAR | match_arm)+ ~ "}" }
match_arm = { match_pattern ~ ":" ~ (match_arm_body | element) ~ NEWLINE_CHAR? }
match_pattern = { "_" | string_lit | number_lit | bool_lit | ident }
match_arm_body = { "{" ~ (NEWLINE_CHAR | statement)* ~ "}" }

// -- Slot: marks where caller content is inserted (inside component definitions)
slot_stmt = { "slot" ~ string_lit? ~ (block | NEWLINE_CHAR) }

// -- Fill: provides content for a named slot at call sites
fill_stmt = { "fill" ~ string_lit ~ block }

// -- Pipeline expressions: source | stage | stage ...
pipe_expression = { expression ~ ("|" ~ pipe_stage)+ | expression }
pipe_stage = { pipe_fn ~ pipe_arg? ~ pipe_arg? }
pipe_fn = { "sort-by" | "group-by" | "filter" | "map" | "take" | "reduce" | "flatten" | "distinct" | "sum" | "count" }
pipe_arg = { expression }

// -- Expressions (for event handler actions)
expression = { expr_atom ~ (bin_op ~ expr_atom)* }
expr_atom = { number_lit | bool_lit | string_lit | "(" ~ expression ~ ")" | function_call | ref_path | ident }
bin_op = { "==" | "!=" | ">=" | "<=" | ">" | "<" | "&&" | "||" | "+" | "-" | "*" | "/" }

// -- Function call: name(arg1, arg2)
function_call = { ident ~ "(" ~ call_args? ~ ")" }
call_args = { expression ~ ("," ~ expression)* }

// -- Elements
// An element is a name optionally followed by:
//   - a string literal (shorthand for text content: heading "Hello")
//   - inline props (key: value, key: value)
//   - a block { ... }
//   - or some combination
element = { ident ~ string_lit? ~ ","? ~ inline_props? ~ (block | NEWLINE_CHAR) }

inline_props = { prop ~ ("," ~ prop)* }
prop = { ident ~ ":" ~ value }

// -- Block: { statements }
block = { "{" ~ (NEWLINE_CHAR | statement)* ~ "}" }

// -- Values
value = { object_lit | list_lit | string_lit | color_lit | number_lit | bool_lit | ref_path | ident }

// Object literal: { key: value, key: value }
object_lit = { "{" ~ (object_entry ~ ("," ~ object_entry)*)? ~ "}" }
object_entry = { ident ~ ":" ~ value }

list_lit = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }

string_lit = ${ "\"" ~ string_part* ~ "\"" }
string_part = _{ interpolation | string_chars }
interpolation = { "{" ~ ref_path_or_ident ~ "}" }
ref_path_or_ident = _{ ref_path | ident }
string_chars = @{ (!"\"" ~ !"\\" ~ !"{" ~ ANY | "\\" ~ ANY)+ }

color_lit = @{ "#" ~ ASCII_HEX_DIGIT{3,8} }

number_lit = ${ number_raw ~ unit? }
number_raw = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
unit = { "px" | "%" | "em" }

duration_lit = ${ number_raw ~ duration_unit }
duration_unit = { "ms" | "min" | "s" | "h" }

bool_lit = { "true" | "false" }

ref_path = @{ ident_raw ~ ("." ~ ident_raw)+ }

// -- Identifiers
ident = @{ ident_raw }
ident_raw = _{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }

// ─── Test file grammar (for .test.naze files) ───────────────────────────────

test_file = { SOI ~ (NEWLINE_CHAR | comment | test_use_stmt | test_block | flow_block)* ~ EOI }
test_use_stmt = { "use" ~ use_path ~ NEWLINE_CHAR }

test_block = { "test" ~ string_lit ~ "{" ~ (NEWLINE_CHAR | test_step)* ~ "}" }
flow_block = { "flow" ~ string_lit ~ "{" ~ (NEWLINE_CHAR | test_step)* ~ "}" }

test_step = _{ test_render | test_click | test_fill | test_navigate | test_wait | test_assert | comment }
test_render = { "render" ~ ident ~ inline_props? ~ NEWLINE_CHAR }
test_click = { "click" ~ string_lit ~ NEWLINE_CHAR }
test_fill = { "fill" ~ string_lit ~ "with" ~ string_lit ~ NEWLINE_CHAR }
test_navigate = { "navigate" ~ string_lit ~ NEWLINE_CHAR }
test_wait = { "wait" ~ duration_lit ~ NEWLINE_CHAR }

test_assert = { "assert" ~ assert_kind ~ NEWLINE_CHAR }
assert_kind = _{ assert_text_not_visible | assert_text_visible | assert_page | assert_state | assert_emitted | assert_a11y }
assert_text_visible = { "text" ~ string_lit ~ "is" ~ "visible" }
assert_text_not_visible = { "text" ~ string_lit ~ "is" ~ "not" ~ "visible" }
assert_page = { "page" ~ "is" ~ string_lit }
assert_state = { "state" ~ ident ~ "is" ~ value }
assert_emitted = { "emitted" ~ ident }
assert_a11y = { "no" ~ "accessibility" ~ "violations" }
