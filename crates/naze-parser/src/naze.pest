// Naze Grammar (Phase 1 + M1 state/let)
// Supports: app blocks, component definitions, use statements,
// spatial primitives (row/column/stack/grid/spacer), rect, text, heading,
// comments, properties with literals (string/number/color/bool/ref),
// let bindings (immutable), state declarations (mutable, reactive),
// string interpolation ({expr} in string literals)

WHITESPACE = _{ " " | "\t" | "\r" }
NEWLINE_CHAR = _{ "\n" }

file = { SOI ~ (NEWLINE_CHAR | statement)* ~ EOI }

statement = _{ comment | use_stmt | component_def | app_block | let_stmt | state_stmt | if_stmt | each_stmt | on_handler | slot_stmt | fill_stmt | element }

// -- Comments
comment = @{ "--" ~ (!NEWLINE_CHAR ~ ANY)* }

// -- Use statement: use components/toolbar
use_stmt = { "use" ~ use_path ~ NEWLINE_CHAR }
use_path = @{ ident_raw ~ ("/" ~ ident_raw)* }

// -- App block: app "Title" { ... }
app_block = { "app" ~ string_lit ~ block }

// -- Component definition: component name(param: type = default) { ... }
component_def = { "component" ~ ident ~ param_list? ~ block }
param_list = { "(" ~ param ~ ("," ~ param)* ~ ")" }
param = { ident ~ ":" ~ type_name ~ ("=" ~ value)? }
type_name = { "text" | "number" | "bool" | "color" }

// -- Let binding (immutable, compile-time): let label = "Hello"
let_stmt = { "let" ~ ident ~ "=" ~ value ~ NEWLINE_CHAR }

// -- State declaration (mutable, reactive): state count = 0
state_stmt = { "state" ~ ident ~ "=" ~ value ~ NEWLINE_CHAR }

// -- Event handler: on click: set count = count + 1
on_handler = { "on" ~ event_name ~ ":" ~ action ~ NEWLINE_CHAR }
event_name = { "click" | "hover" | "keypress" }
action = _{ set_action | navigate_action }
set_action = { "set" ~ ident ~ "=" ~ expression }
navigate_action = { "navigate" ~ string_lit }

// -- Conditional: if expr { ... } else { ... }
if_stmt = { "if" ~ expression ~ block ~ else_clause? }
else_clause = _{ "else" ~ (if_stmt | block) }

// -- Iteration: each item in list { ... }
each_stmt = { "each" ~ ident ~ "in" ~ (ref_path | ident) ~ block }

// -- Slot: marks where caller content is inserted (inside component definitions)
slot_stmt = { "slot" ~ string_lit? ~ (block | NEWLINE_CHAR) }

// -- Fill: provides content for a named slot at call sites
fill_stmt = { "fill" ~ string_lit ~ block }

// -- Expressions (for event handler actions)
expression = { expr_atom ~ (bin_op ~ expr_atom)* }
expr_atom = { number_lit | bool_lit | string_lit | "(" ~ expression ~ ")" | ref_path | ident }
bin_op = { "==" | "!=" | ">=" | "<=" | ">" | "<" | "&&" | "||" | "+" | "-" | "*" | "/" }

// -- Elements
// An element is a name optionally followed by:
//   - a string literal (shorthand for text content: heading "Hello")
//   - inline props (key: value, key: value)
//   - a block { ... }
//   - or some combination
element = { ident ~ string_lit? ~ ","? ~ inline_props? ~ (block | NEWLINE_CHAR) }

inline_props = { prop ~ ("," ~ prop)* }
prop = { ident ~ ":" ~ value }

// -- Block: { statements }
block = { "{" ~ (NEWLINE_CHAR | statement)* ~ "}" }

// -- Values
value = { list_lit | string_lit | color_lit | number_lit | bool_lit | ref_path | ident }

list_lit = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }

string_lit = ${ "\"" ~ string_part* ~ "\"" }
string_part = _{ interpolation | string_chars }
interpolation = { "{" ~ ref_path_or_ident ~ "}" }
ref_path_or_ident = _{ ref_path | ident }
string_chars = @{ (!"\"" ~ !"\\" ~ !"{" ~ ANY | "\\" ~ ANY)+ }

color_lit = @{ "#" ~ ASCII_HEX_DIGIT{3,8} }

number_lit = ${ number_raw ~ unit? }
number_raw = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
unit = { "px" | "%" | "em" }

bool_lit = { "true" | "false" }

ref_path = @{ ident_raw ~ ("." ~ ident_raw)+ }

// -- Identifiers
ident = @{ ident_raw }
ident_raw = _{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }
