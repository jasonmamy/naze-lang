-- Nested rows and columns
app "Nested Layout" {
  column padding: 20px, gap: 16px {
    heading "Nested Layout"
    row gap: 16px {
      column gap: 8px {
        rect width: 100px, height: 100px, color: #3b82f6, radius: 8px
        text "Blue"
      }
      column gap: 8px {
        rect width: 100px, height: 100px, color: #ef4444, radius: 8px
        text "Red"
      }
      column gap: 8px {
        rect width: 100px, height: 100px, color: #22c55e, radius: 8px
        text "Green"
      }
    }
  }
}
