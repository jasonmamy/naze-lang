-- Animation example: demonstrates property transitions

app "Animation Demo"

state expanded = false
state color_index = 0

let colors = ["#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6"]

column gap: 24px, padding: 32px {
    text "Animation Demo", size: 28px, weight: bold
    text "Click the boxes to see smooth transitions", color: #666666

    -- Size transition
    column gap: 8px {
        text "Size Transition", size: 18px, weight: bold

        row
            width: 200px,
            height: if expanded { 150px } else { 60px },
            background: #3b82f6,
            radius: 8px,
            padding: 16px,
            transition: "height 300ms ease-out"
        {
            text if expanded { "Click to shrink" } else { "Click to expand" }, color: #ffffff
            on click: set expanded = !expanded
        }
    }

    -- Color transition
    column gap: 8px {
        text "Color Transition", size: 18px, weight: bold

        row
            width: 200px,
            height: 80px,
            background: if color_index == 0 { #3b82f6 }
                       else if color_index == 1 { #10b981 }
                       else if color_index == 2 { #f59e0b }
                       else if color_index == 3 { #ef4444 }
                       else { #8b5cf6 },
            radius: 8px,
            padding: 16px,
            transition: "background 400ms ease-in-out"
        {
            text "Click to change color", color: #ffffff
            on click: set color_index = (color_index + 1) % 5
        }
    }

    -- Opacity transition
    column gap: 8px {
        text "Opacity Transition", size: 18px, weight: bold

        row
            width: 200px,
            height: 80px,
            background: #8b5cf6,
            radius: 8px,
            padding: 16px,
            opacity: if expanded { 1.0 } else { 0.4 },
            transition: "opacity 250ms ease"
        {
            text "Tied to expand state", color: #ffffff
        }
    }
}
