-- Profile cards with component-like structure
app "Team" {
  state members = [{name: "Alice", role: "Engineer", color: "#2563eb"}, {name: "Bob", role: "Designer", color: "#8b5cf6"}, {name: "Carol", role: "Manager", color: "#16a34a"}]

  column padding: 20px, gap: 16px {
    heading "Our Team"

    row gap: 16px {
      each member in members {
        column padding: 16px, color: #f8fafc, radius: 12px, gap: 8px, width: 180px {
          rect width: 60px, height: 60px, color: #e2e8f0, radius: 30px
          heading "{member.name}" font-size: 18px
          text "{member.role}" color: #64748b
        }
      }
    }
  }
}
