-- Todo list with add and remove
app "Todo" {
  state task = ""
  state items = []

  computed count = items | count

  column padding: 20px, gap: 12px {
    heading "Todo List"

    row gap: 8px {
      input bind: task, placeholder: "New task..."
      rect width: 80px, height: 40px, color: #2563eb, radius: 8px {
        text "Add" color: #ffffff
        on click: append task to items
        on click: set task = ""
      }
    }

    text "{count} items"

    each item in items {
      row gap: 8px, padding: 8px, color: #f3f4f6, radius: 4px {
        text "{item}"
      }
    }
  }
}
