-- Confirmation modal dialog
app "Confirm" {
  state show-modal = false
  state confirmed = false

  column padding: 20px, gap: 16px {
    heading "Modal Example"

    rect width: 160px, height: 40px, color: #dc2626, radius: 8px {
      text "Delete Item" color: #ffffff
      on click: set show-modal = true
    }

    if confirmed {
      text "Item deleted!" color: #16a34a
    }

    if show-modal {
      overlay focus-trap: true {
        rect width: 100%, height: 100%, color: #00000080

        container width: 400px, padding: 24px, radius: 12px, color: #ffffff, shadow: "xl" {
          column gap: 16px {
            heading "Are you sure?" font-size: 20px
            text "This action cannot be undone."
            row gap: 8px {
              rect width: 100px, height: 40px, color: #dc2626, radius: 8px {
                text "Delete" color: #ffffff
                on click: set confirmed = true
                on click: set show-modal = false
              }
              rect width: 100px, height: 40px, color: #e2e8f0, radius: 8px {
                text "Cancel"
                on click: set show-modal = false
              }
            }
          }
        }
        on click-outside: set show-modal = false
      }
    }
  }
}
