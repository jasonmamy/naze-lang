-- Countdown timer
app "Countdown" {
  state seconds = 60

  timer tick: every 1s {
    set seconds = seconds - 1
  }

  column padding: 20px, gap: 16px {
    heading "Countdown Timer"
    heading "{seconds}s" font-size: 48px, color: #2563eb

    row gap: 8px {
      rect width: 100px, height: 40px, color: #64748b, radius: 8px {
        text "Reset" color: #ffffff
        on click: set seconds = 60
      }
    }

    if seconds <= 0 {
      text "Time is up!" color: #dc2626, font-size: 24px
    }
  }
}
