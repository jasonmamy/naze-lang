-- Breadcrumb navigation
app "Docs" {
  row padding: 12px, color: #1e293b {
    heading "Docs" color: #ffffff, font-size: 18px
    spacer
    link "Home", to: "/"
    link "Guide", to: "/guide"
    link "API", to: "/api"
  }

  page "/" {
    column padding: 20px, gap: 12px {
      row gap: 4px {
        text "Home" color: #2563eb
      }
      heading "Documentation"
      text "Welcome to the documentation."
      link "Getting Started", to: "/guide"
    }
  }

  page "/guide" {
    column padding: 20px, gap: 12px {
      row gap: 4px {
        link "Home", to: "/"
        text "/" color: #94a3b8
        text "Guide" color: #2563eb
      }
      heading "Getting Started Guide"
      text "Follow these steps to get started with Naze."
    }
  }

  page "/api" {
    column padding: 20px, gap: 12px {
      row gap: 4px {
        link "Home", to: "/"
        text "/" color: #94a3b8
        text "API" color: #2563eb
      }
      heading "API Reference"
      text "Complete API documentation."
    }
  }
}
