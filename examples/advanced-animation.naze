-- Advanced animation: spring physics, custom easing, keyframes
app "Advanced Animation" {
  state active = false
  state color_mode = 0

  column gap: 24px, padding: 32px {
    heading "Advanced Animation"
    text "Demonstrates spring physics, custom cubic-bezier, and keyframe animations" color: #666666

    -- Spring physics transition
    column gap: 8px {
      heading "Spring Physics" font-size: 18px
      text "Click to toggle — color changes with spring bounce" color: #888888

      if active {
        rect width: 200px, height: 80px, color: #3b82f6, radius: 12px, padding: 16px, transition: "color spring(180, 12)" {
          text "Spring!" color: #ffffff
          on click: set active = false
        }
      }
      if active == false {
        rect width: 200px, height: 80px, color: #ef4444, radius: 12px, padding: 16px, transition: "color spring(180, 12)" {
          text "Click me" color: #ffffff
          on click: set active = true
        }
      }
    }

    -- Custom cubic-bezier
    column gap: 8px {
      heading "Custom Cubic-Bezier" font-size: 18px
      text "Click to toggle — overshoot easing on width" color: #888888

      if active {
        rect width: 300px, height: 60px, color: #10b981, radius: 8px, padding: 16px, transition: "width 500ms cubic-bezier(0.34, 1.56, 0.64, 1)" {
          text "Wide (overshoot)" color: #ffffff
        }
      }
      if active == false {
        rect width: 120px, height: 60px, color: #10b981, radius: 8px, padding: 16px, transition: "width 500ms cubic-bezier(0.34, 1.56, 0.64, 1)" {
          text "Narrow" color: #ffffff
        }
      }
    }

    -- Keyframe animation
    column gap: 8px {
      heading "Keyframe Bounce" font-size: 18px
      text "Toggle to trigger a scale bounce keyframe sequence" color: #888888

      if active {
        rect width: 80px, height: 80px, color: #8b5cf6, radius: 8px, animate: "scale [1, 1.3, 0.9, 1.1, 1] 600ms ease-in-out" {
          text "!" color: #ffffff, font-size: 24px
        }
      }
    }

    -- Color cycle with standard easing for comparison
    column gap: 8px {
      heading "Color Cycle (ease-in-out)" font-size: 18px

      if color_mode == 0 {
        rect width: 200px, height: 80px, color: #3b82f6, radius: 8px, padding: 16px, transition: "color 300ms ease-in-out" {
          text "Blue" color: #ffffff
          on click: set color_mode = 1
        }
      }
      if color_mode == 1 {
        rect width: 200px, height: 80px, color: #f59e0b, radius: 8px, padding: 16px, transition: "color 300ms ease-in-out" {
          text "Amber" color: #ffffff
          on click: set color_mode = 2
        }
      }
      if color_mode == 2 {
        rect width: 200px, height: 80px, color: #ef4444, radius: 8px, padding: 16px, transition: "color 300ms ease-in-out" {
          text "Red" color: #ffffff
          on click: set color_mode = 0
        }
      }
    }
  }
}
