-- Statistics dashboard with computed values
app "Stats" {
  state sales = [{month: "Jan", amount: 1200}, {month: "Feb", amount: 1800}, {month: "Mar", amount: 950}, {month: "Apr", amount: 2200}, {month: "May", amount: 1600}]

  computed total-revenue = sales | map amount | sum
  computed sale-count = sales | count
  computed top-months = sales | filter amount > 1500 | sort-by amount

  column padding: 20px, gap: 16px {
    heading "Sales Dashboard"

    row gap: 16px {
      container padding: 16px, color: #eff6ff, radius: 8px, width: 160px {
        text "Total Revenue"
        heading "${total-revenue}" font-size: 24px
      }
      container padding: 16px, color: #f0fdf4, radius: 8px, width: 160px {
        text "Months"
        heading "{sale-count}" font-size: 24px
      }
    }

    heading "Top Months (>$1500)" font-size: 18px
    each month in top-months {
      row padding: 8px, color: #f8fafc, radius: 4px {
        text "{month.month}" font-weight: bold
        spacer
        text "${month.amount}"
      }
    }
  }
}
