-- Product launch checklist board
app "Launch Board" {
  state todo = [{title: "Press kit", tag: "comms"}, {title: "Demo video", tag: "marketing"}]
  state doing = [{title: "Beta testing", tag: "qa"}]
  state done = [{title: "Docs site", tag: "docs"}]
  computed todo-count = todo | count
  computed doing-count = doing | count
  computed done-count = done | count

  column padding: 24px, gap: 16px {
    heading "Launch Board" color: #059669

    row gap: 16px {
      column gap: 8px {
        row gap: 4px {
          rect width: 10px, height: 10px, color: #86efac, radius: 5px
          text "To Do ({todo-count})" font-weight: bold, font-size: 14px
        }
        each card in todo {
          rect padding: 12px, color: #ecfdf5, radius: 8px {
            text "{card.title}" font-size: 14px
            text "{card.tag}" color: #94a3b8, font-size: 11px
          }
        }
      }

      column gap: 8px {
        row gap: 4px {
          rect width: 10px, height: 10px, color: #10b981, radius: 5px
          text "In Progress ({doing-count})" font-weight: bold, font-size: 14px
        }
        each card in doing {
          rect padding: 12px, color: #ecfdf5, radius: 8px {
            text "{card.title}" font-size: 14px
            text "{card.tag}" color: #94a3b8, font-size: 11px
          }
        }
      }

      column gap: 8px {
        row gap: 4px {
          rect width: 10px, height: 10px, color: #22c55e, radius: 5px
          text "Done ({done-count})" font-weight: bold, font-size: 14px
        }
        each card in done {
          rect padding: 12px, color: #ecfdf5, radius: 8px {
            text "{card.title}" font-size: 14px
            text "{card.tag}" color: #94a3b8, font-size: 11px
          }
        }
      }
    }
  }
}
