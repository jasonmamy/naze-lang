-- Email subscription form
app "Newsletter" {
  state email = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Newsletter"
    text "Subscribe to our newsletter" color: #64748b

    input bind: email, placeholder: "your@email.com"

    row gap: 8px {
      rect width: 100px, height: 36px, color: #16a34a, radius: 4px {
        text "Subscribe" color: #ffffff
        on click: set submitted = true
      }
      rect width: 80px, height: 36px, color: #94a3b8, radius: 4px {
        text "Clear" color: #ffffff
        on click: set email = ""
        on click: set submitted = false
      }
    }

    if submitted {
      rect padding: 12px, color: #f0fdf4, radius: 8px {
        text "Subscribed: {email}" font-weight: bold, color: #16a34a
      }
    }
  }
}
