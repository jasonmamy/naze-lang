-- School portal with classes, grades, and schedule
app "School" {
  column padding: 20px, gap: 16px {
    heading "School"
    text "Student portal"
    link "Classes", to: "/classes"
    link "Grades", to: "/grades"
    link "Schedule", to: "/schedule"
  }
}

page "/classes" {
  column padding: 20px {
    heading "My Classes"
    text "Current enrollment"
    link "Back to Home", to: "/"
  }
}

page "/grades" {
  column padding: 20px {
    heading "Grades"
    text "Academic performance"
    link "Back to Home", to: "/"
  }
}

page "/schedule" {
  column padding: 20px {
    heading "Schedule"
    text "Weekly timetable"
    link "Back to Home", to: "/"
  }
}
