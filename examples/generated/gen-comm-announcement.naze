-- Announcement board with dates
app "Announcements" {
  state items = [{title: "Office Closure", date: "Feb 14"}, {title: "New Policy", date: "Feb 10"}, {title: "Team Outing", date: "Feb 20"}]
  state new-post = ""
  state posted = "idle"
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Announcements"
    text "{total} announcements" color: #64748b

    input bind: new-post, placeholder: "New announcement..."

    rect width: 120px, height: 40px, color: #f59e0b, radius: 8px {
      text "Post New" color: #ffffff
      on click: set posted = "posted"
    }

    if posted == "posted" {
      text "Posted!" color: #16a34a
    }

    each ann in items {
      row padding: 12px, color: #fef3c7, radius: 4px, gap: 8px {
        text "{ann.title}" font-weight: bold
        text "{ann.date}" color: #64748b
      }
    }
  }
}
