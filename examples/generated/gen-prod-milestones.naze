-- Milestone tracker with completion status
app "Milestones" {
  state items = [{name: "MVP Launch", status: "done"}, {name: "Beta Release", status: "in-progress"}, {name: "Public Launch", status: "planned"}]
  state view = "timeline"
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Milestones"
    text "{total} milestones" color: #64748b

    row gap: 8px {
      rect width: 80px, height: 32px, color: #ec4899, radius: 4px {
        text "Timeline" color: #ffffff
        on click: set view = "timeline"
      }
      rect width: 80px, height: 32px, color: #64748b, radius: 4px {
        text "Grid" color: #ffffff
        on click: set view = "grid"
      }
    }

    each ms in items | sort-by name {
      row padding: 12px, color: #fdf2f8, radius: 4px, gap: 12px {
        text "{ms.name}" font-weight: bold
        text "{ms.status}" color: #be185d
      }
    }
  }
}
