-- Price after discount calculator
app "Discount" {
  state price = 100
  state percent-off = 20
  computed final = price - (price * percent-off / 100)

  column padding: 20px, gap: 16px {
    heading "Discount"
    text "Price: {price}" font-size: 18px
    text "Discount %: {percent-off}" color: #64748b
    text "Final: {final}" font-size: 24px, color: #ec4899

    row gap: 8px {
      rect width: 80px, height: 36px, color: #ec4899, radius: 4px {
        text "+" color: #ffffff
        on click: set price = price + 1
      }
      rect width: 80px, height: 36px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set price = 100
      }
    }
  }
}
