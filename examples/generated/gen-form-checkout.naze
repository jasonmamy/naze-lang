-- Checkout form with address and card
app "Checkout" {
  state address = ""
  state card = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Checkout"

    input bind: address, placeholder: "Shipping Address"
    input bind: card, placeholder: "Card Number"

    rect width: 120px, height: 40px, color: #22c55e, radius: 8px {
      text "Pay Now" color: #ffffff
      on click: set submitted = true
    }

    if submitted {
      text "Payment processed!" color: #16a34a
    }
  }
}
