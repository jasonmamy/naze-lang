-- 500 internal server error page
app "Server Error" {
  state action-taken = false

  column padding: 40px, gap: 16px {
    rect width: 100px, height: 100px, color: #fef2f2, radius: 50px {
      text "!" font-size: 40px, color: #ef4444
    }

    heading "Something Went Wrong" font-size: 22px
    text "Our servers encountered an unexpected error. Please try again." color: #64748b

    if action-taken == false {
      rect width: 120px, height: 44px, color: #ef4444, radius: 8px {
        text "Try Again" color: #ffffff
        on click: set action-taken = true
      }
    }

    if action-taken {
      text "Retrying..." color: #16a34a
    }

    text "Error 500 - Internal Server Error" color: #94a3b8, font-size: 13px
  }
}
