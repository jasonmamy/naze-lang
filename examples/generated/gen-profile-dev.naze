-- Developer profile with GitHub link
app "Dev Profile" {
  state username = "alice_dev"
  state bio = "Full-stack developer"
  state followers = 1240
  state following = 310
  computed ratio = followers / following

  column padding: 24px, gap: 16px {
    heading "Dev Profile"

    row gap: 16px {
      rect width: 80px, height: 80px, color: #3b82f6, radius: 40px {
        text "A" color: #ffffff, font-size: 32px
      }
      column gap: 4px {
        text "{username}" font-size: 22px, font-weight: bold
        text "{bio}" color: #64748b
      }
    }

    grid columns: 3, gap: 12px {
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Followers" color: #64748b, font-size: 12px
        text "{followers}" font-size: 20px, color: #2563eb
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Following" color: #64748b, font-size: 12px
        text "{following}" font-size: 20px, color: #2563eb
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Ratio" color: #64748b, font-size: 12px
        text "{ratio}" font-size: 20px, color: #2563eb
      }
    }

    separator

    rect padding: 12px, color: #eff6ff, radius: 8px {
      link "GitHub" href: "https://github.com"
    }
  }
}
