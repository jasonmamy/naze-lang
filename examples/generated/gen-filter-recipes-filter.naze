-- Recipe filter panel with cuisine and cook time
app "Recipe Filters" {
  state max-time = 60
  state cuisine = "all"
  state results-count = 120

  column padding: 20px, gap: 16px {
    heading "Recipe Filters"
    text "{results-count} results" color: #64748b

    rect padding: 16px, color: #f8fafc, radius: 8px {
      text "Filters" font-weight: bold, font-size: 16px

      text "Cuisine" font-weight: bold, color: #374151, font-size: 14px
      select bind: cuisine {
      option "All" value: "all"
      option "Italian" value: "italian"
      option "Asian" value: "asian"
      option "Mexican" value: "mexican"
    }

      text "Max Cook Time (min)" font-weight: bold, color: #374151, font-size: 14px
      input bind: max-time, placeholder: "Minutes"
    }

    rect width: 120px, height: 36px, color: #ea580c, radius: 4px {
      text "Apply Filters" color: #ffffff
      on click: set results-count = 18
    }

    rect width: 100px, height: 36px, color: #e2e8f0, radius: 4px {
      text "Clear All"
      on click: set max-time = 60
    }
  }
}
