-- Study group member avatars
app "Study Group" {
  column padding: 24px, gap: 16px {
    heading "Study Group"

    row gap: 16px {
      column gap: 4px {
        rect width: 48px, height: 48px, color: #f97316, radius: 24px {
          text "MJ" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Maya J." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #14b8a6, radius: 24px {
          text "SK" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Sam K." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #6366f1, radius: 24px {
          text "LR" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Leo R." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #ec4899, radius: 24px {
          text "DW" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Dina W." font-size: 12px, color: #64748b
      }
    }

    text "Members of Calculus 201 group" color: #94a3b8, font-size: 14px
  }
}
