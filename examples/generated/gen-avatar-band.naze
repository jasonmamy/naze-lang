-- Music band member profile avatars
app "Band Members" {
  column padding: 24px, gap: 16px {
    heading "Band Members"

    row gap: 16px {
      column gap: 4px {
        rect width: 48px, height: 48px, color: #1e293b, radius: 24px {
          text "VO" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Vocals" font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #ef4444, radius: 24px {
          text "GT" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Guitar" font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #eab308, radius: 24px {
          text "BS" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Bass" font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #6366f1, radius: 24px {
          text "DR" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Drums" font-size: 12px, color: #64748b
      }
    }

    text "The Midnight Signal" color: #94a3b8, font-size: 14px
  }
}
