-- Code reviewer avatar badges
app "Reviewers" {
  column padding: 24px, gap: 16px {
    heading "Reviewers"

    row gap: 16px {
      column gap: 4px {
        rect width: 48px, height: 48px, color: #8b5cf6, radius: 24px {
          text "JK" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Jake K." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #0891b2, radius: 24px {
          text "LM" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Luna M." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #e11d48, radius: 24px {
          text "NO" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Nora O." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #84cc16, radius: 24px {
          text "PQ" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Paul Q." font-size: 12px, color: #64748b
      }
    }

    text "Assigned reviewers for this PR" color: #94a3b8, font-size: 14px
  }
}
