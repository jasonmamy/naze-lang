-- File rename dialog
app "Rename" {
  state new-name = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Rename"
    text "Enter new name for this file" color: #64748b

    input bind: new-name, placeholder: "document.txt"

    row gap: 8px {
      rect width: 100px, height: 36px, color: #0891b2, radius: 4px {
        text "Rename" color: #ffffff
        on click: set submitted = true
      }
      rect width: 80px, height: 36px, color: #94a3b8, radius: 4px {
        text "Clear" color: #ffffff
        on click: set new-name = ""
        on click: set submitted = false
      }
    }

    if submitted {
      rect padding: 12px, color: #ecfeff, radius: 8px {
        text "Renamed to: {new-name}" font-weight: bold, color: #0891b2
      }
    }
  }
}
