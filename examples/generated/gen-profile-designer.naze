-- UI designer portfolio profile
app "Designer Profile" {
  state username = "maria_ux"
  state bio = "UI/UX designer and illustrator"
  state followers = 3400
  state following = 180
  computed ratio = followers / following

  column padding: 24px, gap: 16px {
    heading "Designer Profile"

    row gap: 16px {
      rect width: 80px, height: 80px, color: #ec4899, radius: 40px {
        text "M" color: #ffffff, font-size: 32px
      }
      column gap: 4px {
        text "{username}" font-size: 22px, font-weight: bold
        text "{bio}" color: #64748b
      }
    }

    grid columns: 3, gap: 12px {
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Followers" color: #64748b, font-size: 12px
        text "{followers}" font-size: 20px, color: #db2777
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Following" color: #64748b, font-size: 12px
        text "{following}" font-size: 20px, color: #db2777
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Ratio" color: #64748b, font-size: 12px
        text "{ratio}" font-size: 20px, color: #db2777
      }
    }

    separator

    rect padding: 12px, color: #fdf2f8, radius: 8px {
      link "Dribbble" href: "https://dribbble.com"
    }
  }
}
