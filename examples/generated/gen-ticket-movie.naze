-- Cinema movie ticket
app "Movie Ticket" {
  state ticket-id = "CIN-3300"
  state status = "Valid"
  state priority = "Premium"

  column padding: 24px, gap: 16px {
    heading "Movie Ticket" color: #a21caf

    rect padding: 20px, color: #ffffff, radius: 12px {
      column gap: 12px {
        row gap: 8px {
          text "Cinema Ticket" font-weight: bold, font-size: 18px
          spacer
          rect padding: 6px, color: #fdf4ff, radius: 4px {
            text "{status}" color: #a21caf, font-size: 12px
          }
        }

        separator

        row gap: 16px {
          column gap: 4px {
            text "ID" color: #94a3b8, font-size: 11px
            text "{ticket-id}" font-size: 14px
          }
          column gap: 4px {
            text "Priority" color: #94a3b8, font-size: 11px
            text "{priority}" font-size: 14px, color: #d97706
          }
          column gap: 4px {
            text "Screen" color: #94a3b8, font-size: 11px
            text "IMAX 2" font-size: 14px
          }
        }

        separator

        text "Interstellar - Director's Cut" color: #334155
        text "Friday 7:30 PM - Seats J11, J12" color: #64748b, font-size: 13px
      }
    }

    match status {
      "Valid": rect padding: 10px, color: #fdf4ff, radius: 8px {
        text "Present QR code at entrance" color: #a21caf, font-size: 13px
      }
      _: text "Unknown status" color: #94a3b8
    }
  }
}
