-- Code editor customization settings
app "Editor Preferences" {
  state auto-save = true
  state line-numbers = true
  state tab-size = ""
  state saved = false

  column padding: 24px, gap: 16px {
    heading "Editor Preferences"
    text "Customize your editor" color: #64748b

    column gap: 12px {
      column gap: 4px {
        text "Auto Save" font-weight: bold, font-size: 14px
        checkbox bind: auto-save, label: "Save automatically"
      }

      column gap: 4px {
        text "Line Numbers" font-weight: bold, font-size: 14px
        checkbox bind: line-numbers, label: "Show line numbers"
      }

      column gap: 4px {
        text "Tab Size" font-weight: bold, font-size: 14px
        input bind: tab-size, placeholder: "Tab size (2 or 4)"
      }
    }

    separator

    row gap: 8px {
      rect width: 100px, height: 40px, color: #475569, radius: 8px {
        text "Save" color: #ffffff
        on click: set saved = true
      }
      rect width: 100px, height: 40px, color: #e2e8f0, radius: 8px {
        text "Cancel"
        on click: set saved = false
      }
    }

    if saved {
      text "Editor preferences saved!" color: #16a34a
    }
  }
}
