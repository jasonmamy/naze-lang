-- Git repository statistics
app "Repo Stats" {
  state commits = 342
  state issues = 17

  column padding: 20px, gap: 16px {
    heading "Repo Stats"
    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #f5f3ff, radius: 8px {
        text "Commits" color: #64748b, font-size: 12px
        text "{commits}" font-size: 24px, color: #8b5cf6
      }
      rect padding: 16px, color: #fef2f2, radius: 8px {
        text "Issues" color: #64748b, font-size: 12px
        text "{issues}" font-size: 24px, color: #dc2626
      }
    }
    row gap: 8px {
      rect width: 80px, height: 32px, color: #8b5cf6, radius: 4px {
        text "+1" color: #ffffff
        on click: set commits = commits + 1
      }
      rect width: 80px, height: 32px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set commits = 342
      }
    }
  }
}
