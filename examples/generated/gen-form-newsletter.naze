-- Newsletter signup with name and email
app "Newsletter" {
  state name = ""
  state email = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Newsletter"

    input bind: name, placeholder: "Name"
    input bind: email, placeholder: "Email"

    rect width: 120px, height: 40px, color: #14b8a6, radius: 8px {
      text "Subscribe" color: #ffffff
      on click: set submitted = true
    }

    if submitted {
      text "Subscribed!" color: #16a34a
    }
  }
}
