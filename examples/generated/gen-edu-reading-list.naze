-- Reading list with books and authors
app "Reading List" {
  state items = [{title: "Clean Code", author: "Robert Martin"}, {title: "Designing Data Apps", author: "Martin Kleppmann"}, {title: "The Pragmatic Programmer", author: "Hunt and Thomas"}]
  state current = 0
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Reading List"
    text "{current} of {total} read" color: #f97316

    each book in items {
      rect padding: 12px, color: #fff7ed, radius: 8px {
        column gap: 4px {
          text "{book.title}" font-weight: bold
          text "{book.author}" color: #64748b
        }
      }
    }

    row gap: 8px {
      rect width: 100px, height: 36px, color: #f97316, radius: 8px {
        text "Mark Read" color: #ffffff
        on click: set current = current + 1
      }
      rect width: 100px, height: 36px, color: #e2e8f0, radius: 4px {
        text "Reset"
        on click: set current = 0
      }
    }
  }
}
