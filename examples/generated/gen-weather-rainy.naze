-- Rainy weather with high humidity
app "Rainy Day" {
  state temp = 12
  state feels-like = 10
  state humidity = 92
  state wind = 18
  state condition = "Heavy Rain"

  column padding: 24px, gap: 16px, color: #f0f9ff {
    heading "Seattle Weather" color: #1d4ed8

    row gap: 16px {
      rect width: 80px, height: 80px, color: #dbeafe, radius: 12px {
        text "RN" font-size: 36px
      }
      column gap: 4px {
        text "{temp}C" font-size: 48px, font-weight: bold, color: #1d4ed8
        text "{condition}" color: #64748b, font-size: 16px
      }
    }

    grid columns: 3, gap: 12px {
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Feels Like" color: #64748b, font-size: 11px
        text "{feels-like}C" font-size: 18px
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Humidity" color: #64748b, font-size: 11px
        text "{humidity}%" font-size: 18px
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Wind" color: #64748b, font-size: 11px
        text "{wind} km/h" font-size: 18px
      }
    }

    separator

    text "Forecast: Rain continues through Thursday" color: #94a3b8, font-size: 13px
  }
}
