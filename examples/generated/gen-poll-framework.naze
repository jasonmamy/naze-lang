-- Frontend framework preference survey
app "Framework Poll" {
  state opt-a = 30
  state opt-b = 25
  state opt-c = 18
  computed total-votes = opt-a + opt-b + opt-c

  column padding: 24px, gap: 16px {
    heading "Framework Poll" color: #3b82f6
    text "Preferred framework?" font-size: 18px
    text "Total votes: {total-votes}" color: #64748b

    row gap: 8px {
      rect width: 120px, height: 40px, color: #3b82f6, radius: 8px {
        text "React ({opt-a})" color: #ffffff
        on click: set opt-a = opt-a + 1
      }
      rect width: 120px, height: 40px, color: #64748b, radius: 8px {
        text "Vue ({opt-b})" color: #ffffff
        on click: set opt-b = opt-b + 1
      }
      rect width: 120px, height: 40px, color: #94a3b8, radius: 8px {
        text "Svelte ({opt-c})" color: #ffffff
        on click: set opt-c = opt-c + 1
      }
    }

    column gap: 4px {
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "React" font-size: 12px
      }
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Vue" font-size: 12px
      }
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Svelte" font-size: 12px
      }
    }
  }
}
