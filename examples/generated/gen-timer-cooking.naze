-- Cooking timer counting down minutes
app "Cooking Timer" {
  state mins = 15
  state active = false

  timer tick: every 1min {
    set mins = mins - 1
  }

  column padding: 20px, gap: 16px {
    heading "Cooking Timer"
    text "{mins} minutes" font-size: 48px, color: #f97316

    row gap: 8px {
      rect width: 100px, height: 40px, color: #16a34a, radius: 8px {
        text "Start" color: #ffffff
        on click: set active = true
      }
      rect width: 100px, height: 40px, color: #dc2626, radius: 8px {
        text "Reset" color: #ffffff
        on click: set mins = 15
      }
    }
  }
}
