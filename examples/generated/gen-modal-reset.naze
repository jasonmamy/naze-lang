-- Reset to defaults confirmation modal
app "Reset Settings" {
  state show-modal = false
  state confirmed = false

  column padding: 24px, gap: 16px {
    heading "Reset Settings"
    text "Your settings have been customized." color: #64748b

    rect width: 140px, height: 40px, color: #dc2626, radius: 8px {
      text "Reset All" color: #ffffff
      on click: set show-modal = true
    }

    if confirmed {
      rect padding: 12px, color: #f0fdf4, radius: 8px {
        text "Settings reset to defaults." color: #16a34a
      }
    }

    if show-modal {
      rect width: 400px, height: 220px, color: #00000066, radius: 0px {
        rect width: 360px, height: 180px, color: #ffffff, radius: 12px {
          column padding: 24px, gap: 12px {
            text "Reset Settings?" font-weight: bold, font-size: 18px
            text "All settings will return to their default values." color: #64748b
            row gap: 8px {
              rect width: 100px, height: 36px, color: #dc2626, radius: 6px {
                text "Reset" color: #ffffff
                on click: set confirmed = true
                on click: set show-modal = false
              }
              rect width: 100px, height: 36px, color: #e2e8f0, radius: 6px {
                text "Keep" color: #334155
                on click: set show-modal = false
              }
            }
          }
        }
      }
    }
  }
}
