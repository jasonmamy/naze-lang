-- User profile card with stats
app "User Profile" {
  state user-name = "Alice Johnson"

  column padding: 20px, gap: 16px {
    heading "User Profile"

    rect width: 320px, color: #f8fafc, radius: 12px, padding: 20px {
      column gap: 8px {
        text "{user-name}" font-size: 22px, font-weight: bold
        text "Senior Engineer" color: #64748b
        separator
        row gap: 12px {
          text "Posts: 142" color: #2563eb
          text "Followers: 1.2k" color: #2563eb
        }
        text "Joined March 2022" color: #94a3b8, font-size: 13px
      }
    }
  }
}
