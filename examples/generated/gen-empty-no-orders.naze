-- Empty order history state
app "No Orders" {
  column padding: 40px, gap: 20px {
    spacer height: 40px

    rect width: 80px, height: 80px, color: #fff7ed, radius: 40px {
      text "#" font-size: 32px, color: #f97316
    }

    heading "No Orders Yet" font-size: 22px, color: #1e293b
    text "You have not placed any orders." color: #64748b, font-size: 16px
    text "Browse our catalog to find something you like." color: #94a3b8, font-size: 14px

    rect width: 160px, height: 44px, color: #f97316, radius: 8px {
      text "Start Shopping" color: #ffffff, font-size: 15px
      on click: navigate "/shop"
    }
  }
}
