-- Multi-step checkout with shipping and payment
app "Checkout" {
  state step = 1
  state ship-address = ""
  state card-number = ""
  state promo-code = ""

  column padding: 24px, gap: 16px {
    heading "Checkout"
    text "Step {step} of 3" color: #64748b

    match step {
      1: column gap: 12px {
        text "Shipping" font-weight: bold, font-size: 18px
        text "Where should we deliver?" color: #64748b
        input bind: ship-address, placeholder: "Full address"
        rect width: 100px, height: 40px, color: #0ea5e9, radius: 8px {
          text "Next" color: #ffffff
          on click: set step = 2
        }
      }
      2: column gap: 12px {
        text "Payment" font-weight: bold, font-size: 18px
        text "Enter payment details" color: #64748b
        input bind: card-number, placeholder: "Card number"
        row gap: 8px {
          rect width: 100px, height: 40px, color: #e2e8f0, radius: 8px {
            text "Back"
            on click: set step = 1
          }
          rect width: 100px, height: 40px, color: #0ea5e9, radius: 8px {
            text "Next" color: #ffffff
            on click: set step = 3
          }
        }
      }
      3: column gap: 12px {
        text "Review" font-weight: bold, font-size: 18px
        text "Apply a promo code" color: #64748b
        input bind: promo-code, placeholder: "Promo code (optional)"
        row gap: 8px {
          rect width: 100px, height: 40px, color: #e2e8f0, radius: 8px {
            text "Back"
            on click: set step = 2
          }
          rect width: 120px, height: 40px, color: #22c55e, radius: 8px {
            text "Place Order" color: #ffffff
            on click: set step = 1
          }
        }
      }
      _: text "Unknown step"
    }
  }
}
