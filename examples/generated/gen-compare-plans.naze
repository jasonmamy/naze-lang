-- Compare subscription plans side by side
app "Plan Comparison" {
  state selected = "none"

  column padding: 20px, gap: 16px {
    heading "Plan Comparison"
    text "Choose the right plan" color: #64748b

    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #f0f9ff, radius: 8px {
        text "Basic" font-weight: bold, font-size: 18px
        text "$9/mo" color: #64748b
        separator
        text "5 Projects"
        text "1GB Storage"
        text "Email Support"
        rect width: 100px, height: 32px, color: #2563eb, radius: 4px {
          text "Select" color: #ffffff
          on click: set selected = "Basic"
        }
      }
      rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Pro" font-weight: bold, font-size: 18px
        text "$29/mo" color: #64748b
        separator
        text "Unlimited Projects"
        text "100GB Storage"
        text "Priority Support"
        rect width: 100px, height: 32px, color: #2563eb, radius: 4px {
          text "Select" color: #ffffff
          on click: set selected = "Pro"
        }
      }
    }

    if selected != "none" {
      text "Selected: {selected}" color: #2563eb, font-weight: bold
    }
  }
}
