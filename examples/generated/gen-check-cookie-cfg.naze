-- Cookie consent settings
app "Cookie Preferences" {
  state necessary = true
  state analytics-cookies = false
  state marketing-cookies = false
  state saved = false

  column padding: 20px, gap: 16px {
    heading "Cookie Preferences"
    text "Manage cookie preferences" color: #64748b

    rect padding: 16px, color: #f8fafc, radius: 8px {
      column gap: 12px {
        checkbox bind: necessary, label: "Necessary cookies"
        checkbox bind: analytics-cookies, label: "Analytics cookies"
        checkbox bind: marketing-cookies, label: "Marketing cookies"
      }
    }

    row gap: 8px {
      rect width: 80px, height: 36px, color: #64748b, radius: 4px {
        text "Save" color: #ffffff
        on click: set saved = true
      }
    }

    if saved {
      text "Settings saved!" color: #16a34a
    }
  }
}
