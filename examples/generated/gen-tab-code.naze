-- Code editor tabs for file switching
app "Code Editor" {
  state tab = "html"

  column padding: 20px, gap: 16px {
    heading "Code Editor"

    row gap: 0px {
      rect width: 100px, height: 36px, color: #1e293b, radius: 0px {
        text "HTML" color: #e2e8f0
        on click: set tab = "html"
      }
      rect width: 100px, height: 36px, color: #334155, radius: 0px {
        text "CSS" color: #94a3b8
        on click: set tab = "css"
      }
      rect width: 100px, height: 36px, color: #334155, radius: 0px {
        text "JS" color: #94a3b8
        on click: set tab = "js"
      }
    }

    match tab {
      "html": column padding: 16px, gap: 8px {
        text "index.html" font-weight: bold
        text "Main document structure and content." color: #64748b
      }
      "css": column padding: 16px, gap: 8px {
        text "styles.css" font-weight: bold
        text "Layout, colors, and typography rules." color: #64748b
      }
      "js": column padding: 16px, gap: 8px {
        text "app.js" font-weight: bold
        text "Event handlers and application logic." color: #64748b
      }
      _: text "Select a tab"
    }
  }
}
