-- Library book hold ticket
app "Library Card" {
  state ticket-id = "LIB-8821"
  state status = "Ready"
  state priority = "Standard"

  column padding: 24px, gap: 16px {
    heading "Library Card" color: #92400e

    rect padding: 20px, color: #ffffff, radius: 12px {
      column gap: 12px {
        row gap: 8px {
          text "Hold Ticket" font-weight: bold, font-size: 18px
          spacer
          rect padding: 6px, color: #fef3c7, radius: 4px {
            text "{status}" color: #92400e, font-size: 12px
          }
        }

        separator

        row gap: 16px {
          column gap: 4px {
            text "ID" color: #94a3b8, font-size: 11px
            text "{ticket-id}" font-size: 14px
          }
          column gap: 4px {
            text "Priority" color: #94a3b8, font-size: 11px
            text "{priority}" font-size: 14px, color: #64748b
          }
          column gap: 4px {
            text "Shelf" color: #94a3b8, font-size: 11px
            text "Holds-C" font-size: 14px
          }
        }

        separator

        text "Dune by Frank Herbert - Hardcover" color: #334155
        text "Pickup by: Feb 28, 2026 - Card #44201" color: #64748b, font-size: 13px
      }
    }

    match status {
      "Ready": rect padding: 10px, color: #fef3c7, radius: 8px {
        text "Ready for pickup at front desk" color: #92400e, font-size: 13px
      }
      _: text "Unknown status" color: #94a3b8
    }
  }
}
