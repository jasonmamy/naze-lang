-- Empty file storage state page
app "No Files" {
  column padding: 40px, gap: 20px {
    spacer height: 40px

    rect width: 80px, height: 80px, color: #ecfeff, radius: 40px {
      text "^" font-size: 32px, color: #0891b2
    }

    heading "No Files Uploaded" font-size: 22px, color: #1e293b
    text "Upload your first file to get started." color: #64748b, font-size: 16px
    text "Drag and drop or click to upload." color: #94a3b8, font-size: 14px

    rect width: 160px, height: 44px, color: #0891b2, radius: 8px {
      text "Upload File" color: #ffffff, font-size: 15px
      on click: navigate "/upload"
    }
  }
}
