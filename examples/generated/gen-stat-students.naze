-- Classroom attendance tracker
app "Class Stats" {
  state present = 28
  state absent = 4

  column padding: 20px, gap: 16px {
    heading "Class Stats"
    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Present" color: #64748b, font-size: 12px
        text "{present}" font-size: 24px, color: #3b82f6
      }
      rect padding: 16px, color: #fce7f3, radius: 8px {
        text "Absent" color: #64748b, font-size: 12px
        text "{absent}" font-size: 24px, color: #ec4899
      }
    }
    row gap: 8px {
      rect width: 80px, height: 32px, color: #3b82f6, radius: 4px {
        text "+1" color: #ffffff
        on click: set present = present + 1
      }
      rect width: 80px, height: 32px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set present = 28
      }
    }
  }
}
