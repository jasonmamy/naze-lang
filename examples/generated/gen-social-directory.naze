-- User directory with departments
app "User Directory" {
  state items = [{name: "Nina", dept: "Engineering"}, {name: "Oscar", dept: "Design"}, {name: "Pat", dept: "Marketing"}]
  state new-entry = ""
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "User Directory"
    text "{total} members" color: #64748b

    row gap: 8px {
      input bind: new-entry, placeholder: "Invite by email..."
      rect width: 80px, height: 40px, color: #f97316, radius: 8px {
        text "Invite" color: #ffffff
        on click: append new-entry to items
      }
    }

    each member in items {
      row padding: 12px, color: #fff7ed, radius: 8px, gap: 8px {
        text "{member.name}" font-weight: bold
        text "{member.dept}" color: #64748b
      }
    }
  }
}
