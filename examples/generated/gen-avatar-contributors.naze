-- Open source contributor avatars
app "Contributors" {
  column padding: 24px, gap: 16px {
    heading "Contributors"

    row gap: 16px {
      column gap: 4px {
        rect width: 48px, height: 48px, color: #0f172a, radius: 24px {
          text "KL" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Kai L." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #7c3aed, radius: 24px {
          text "NP" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Nia P." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #06b6d4, radius: 24px {
          text "OQ" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Omar Q." font-size: 12px, color: #64748b
      }
      column gap: 4px {
        rect width: 48px, height: 48px, color: #f43f5e, radius: 24px {
          text "RD" color: #ffffff, font-size: 18px, font-weight: bold
        }
        text "Rita D." font-size: 12px, color: #64748b
      }
    }

    text "Top contributors this month" color: #94a3b8, font-size: 14px
  }
}
