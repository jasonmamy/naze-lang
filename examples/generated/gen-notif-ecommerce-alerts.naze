-- E-commerce order notifications
app "Shop Alerts" {
  state unread = 3
  state notifications = [{title: "Order shipped", body: "Your package is on the way", time: "1 hour ago"}, {title: "Price drop", body: "Wishlist item now 20% off", time: "3 hours ago"}, {title: "Review request", body: "Rate your recent purchase", time: "Yesterday"}]
  computed total = notifications | count
  state filter = "all"

  column padding: 24px, gap: 16px {
    heading "Shop Alerts" color: #ea580c

    row gap: 8px {
      text "Notifications" font-size: 18px, font-weight: bold
      rect padding: 4px, color: #fff7ed, radius: 10px {
        text "{unread}" color: #c2410c, font-size: 12px
      }
      spacer
      rect padding: 8px, color: #f1f5f9, radius: 4px {
        text "Mark all read" font-size: 12px, color: #64748b
        on click: set unread = 0
      }
    }

    row gap: 8px {
      rect padding: 6px, color: #ea580c, radius: 4px {
        text "All" color: #ffffff, font-size: 12px
        on click: set filter = "all"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Orders" font-size: 12px
        on click: set filter = "Orders"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Deals" font-size: 12px
        on click: set filter = "Deals"
      }
    }

    text "{total} notifications" color: #94a3b8, font-size: 12px

    each notif in notifications {
      rect padding: 12px, color: #fffbeb, radius: 8px {
        column gap: 4px {
          row gap: 8px {
            rect width: 8px, height: 8px, color: #f97316, radius: 4px
            text "{notif.title}" font-weight: bold, font-size: 14px
          }
          text "{notif.body}" color: #64748b, font-size: 13px
          text "{notif.time}" color: #94a3b8, font-size: 11px
        }
      }
    }
  }
}
