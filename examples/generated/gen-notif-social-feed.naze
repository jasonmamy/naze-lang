-- Social media notification feed
app "Social Alerts" {
  state unread = 12
  state notifications = [{title: "New follower", body: "Emma started following you", time: "Just now"}, {title: "Like", body: "Your post got 50 likes", time: "10 min ago"}, {title: "Comment", body: "Jake commented on your photo", time: "1 hour ago"}]
  computed total = notifications | count
  state filter = "all"

  column padding: 24px, gap: 16px {
    heading "Social Alerts" color: #ec4899

    row gap: 8px {
      text "Notifications" font-size: 18px, font-weight: bold
      rect padding: 4px, color: #fce7f3, radius: 10px {
        text "{unread}" color: #be185d, font-size: 12px
      }
      spacer
      rect padding: 8px, color: #f1f5f9, radius: 4px {
        text "Mark all read" font-size: 12px, color: #64748b
        on click: set unread = 0
      }
    }

    row gap: 8px {
      rect padding: 6px, color: #ec4899, radius: 4px {
        text "All" color: #ffffff, font-size: 12px
        on click: set filter = "all"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Likes" font-size: 12px
        on click: set filter = "Likes"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Comments" font-size: 12px
        on click: set filter = "Comments"
      }
    }

    text "{total} notifications" color: #94a3b8, font-size: 12px

    each notif in notifications {
      rect padding: 12px, color: #fdf2f8, radius: 8px {
        column gap: 4px {
          row gap: 8px {
            rect width: 8px, height: 8px, color: #f472b6, radius: 4px
            text "{notif.title}" font-weight: bold, font-size: 14px
          }
          text "{notif.body}" color: #64748b, font-size: 13px
          text "{notif.time}" color: #94a3b8, font-size: 11px
        }
      }
    }
  }
}
