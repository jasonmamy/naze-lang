-- Theme color selector
app "Theme" {
  state choice = "light"

  column padding: 20px, gap: 16px {
    heading "Theme"

    select bind: choice {
      option "Light" value: "light"
      option "Dark" value: "dark"
      option "System" value: "system"
    }

    match choice {
      "light": rect padding: 16px, color: #f8fafc, radius: 8px {
        text "Light mode active" color: #334155
      }
      "dark": rect padding: 16px, color: #1e293b, radius: 8px {
        text "Dark mode active" color: #e2e8f0
      }
      "system": rect padding: 16px, color: #f1f5f9, radius: 8px {
        text "Following system preference" color: #64748b
      }
      _: text "Select an option" color: #94a3b8
    }
  }
}
