-- Home energy usage dashboard
app "Energy" {
  state solar-kw = 4
  state usage-kw = 6
  state cost = 85
  state savings = 30

  column padding: 20px, gap: 16px {
    heading "Energy"

    grid columns: 2, gap: 16px {
      rect padding: 16px, color: #fefce8, radius: 8px {
        text "Solar (kW)" color: #64748b, font-size: 14px
        text "{solar-kw}" font-size: 28px
      }
      rect padding: 16px, color: #fce7f3, radius: 8px {
        text "Usage (kW)" color: #64748b, font-size: 14px
        text "{usage-kw}" font-size: 28px
      }
      rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Cost ($)" color: #64748b, font-size: 14px
        text "{cost}" font-size: 28px
      }
      rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Savings %" color: #64748b, font-size: 14px
        text "{savings}" font-size: 28px
      }
    }
  }
}
