-- Todo items fetched from API
app "Todos" {
  data todos: fetch "/api/todos"

  column padding: 20px, gap: 16px {
    heading "Todos"

    if todos.loading {
      text "Loading todos..." color: #64748b
    }

    if todos.error {
      text "Failed to load todos" color: #dc2626
    }

    if todos.data {
      text "todos loaded successfully" color: #16a34a
      each todo in todos.data {
        row padding: 8px, color: #ecfdf5, radius: 4px {
          text "{todo.title}"
        }
      }
    }
  }
}
