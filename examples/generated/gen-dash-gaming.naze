-- Gaming statistics dashboard
app "Game Stats" {
  state score = 42000
  state level = 28
  state wins = 156
  state streak = 12

  column padding: 20px, gap: 16px {
    heading "Game Stats"

    grid columns: 2, gap: 16px {
      rect padding: 16px, color: #faf5ff, radius: 8px {
        text "Score" color: #64748b, font-size: 14px
        text "{score}" font-size: 28px
      }
      rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Level" color: #64748b, font-size: 14px
        text "{level}" font-size: 28px
      }
      rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Wins" color: #64748b, font-size: 14px
        text "{wins}" font-size: 28px
      }
      rect padding: 16px, color: #fefce8, radius: 8px {
        text "Win Streak" color: #64748b, font-size: 14px
        text "{streak}" font-size: 28px
      }
    }
  }
}
