-- Recruitment process timeline
app "Hiring Pipeline" {
  state events = [{time: "Week 1", title: "Posted", detail: "Job listing published"}, {time: "Week 3", title: "Screening", detail: "50 applications reviewed"}, {time: "Week 5", title: "Interviews", detail: "8 candidates interviewed"}, {time: "Week 6", title: "Offer", detail: "Offer extended to top candidate"}]
  computed total = events | count

  column padding: 24px, gap: 8px {
    heading "Hiring Pipeline" color: #059669
    text "{total} events" color: #94a3b8, font-size: 12px

    each evt in events {
      row gap: 12px {
        column gap: 0px {
          rect width: 12px, height: 12px, color: #10b981, radius: 6px
          rect width: 2px, height: 40px, color: #e2e8f0
        }
        column gap: 2px {
          text "{evt.time}" color: #94a3b8, font-size: 11px
          text "{evt.title}" font-weight: bold
          text "{evt.detail}" color: #64748b, font-size: 13px
        }
      }
    }
  }
}
