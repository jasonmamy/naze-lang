-- Compare laptop specs and pricing
app "Laptop Comparison" {
  state selected = "none"

  column padding: 20px, gap: 16px {
    heading "Laptop Comparison"
    text "Find your perfect laptop" color: #64748b

    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #f8fafc, radius: 8px {
        text "Ultrabook" font-weight: bold, font-size: 18px
        text "$1299" color: #64748b
        separator
        text "14 inch, 2.2 lbs"
        text "16GB RAM"
        text "512GB SSD"
        rect width: 100px, height: 32px, color: #0284c7, radius: 4px {
          text "Select" color: #ffffff
          on click: set selected = "Ultrabook"
        }
      }
      rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Workstation" font-weight: bold, font-size: 18px
        text "$1899" color: #64748b
        separator
        text "16 inch, 4.5 lbs"
        text "32GB RAM"
        text "1TB SSD"
        rect width: 100px, height: 32px, color: #0284c7, radius: 4px {
          text "Select" color: #ffffff
          on click: set selected = "Workstation"
        }
      }
    }

    if selected != "none" {
      text "Selected: {selected}" color: #0284c7, font-weight: bold
    }
  }
}
