-- Research scientist profile
app "Scientist Profile" {
  state username = "dr_chen"
  state bio = "AI researcher and professor"
  state followers = 3100
  state following = 270
  computed ratio = followers / following

  column padding: 24px, gap: 16px {
    heading "Scientist Profile"

    row gap: 16px {
      rect width: 80px, height: 80px, color: #0ea5e9, radius: 40px {
        text "D" color: #ffffff, font-size: 32px
      }
      column gap: 4px {
        text "{username}" font-size: 22px, font-weight: bold
        text "{bio}" color: #64748b
      }
    }

    grid columns: 3, gap: 12px {
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Followers" color: #64748b, font-size: 12px
        text "{followers}" font-size: 20px, color: #0284c7
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Following" color: #64748b, font-size: 12px
        text "{following}" font-size: 20px, color: #0284c7
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Ratio" color: #64748b, font-size: 12px
        text "{ratio}" font-size: 20px, color: #0284c7
      }
    }

    separator

    rect padding: 12px, color: #f0f9ff, radius: 8px {
      link "Papers" href: "https://scholar.google.com"
    }
  }
}
