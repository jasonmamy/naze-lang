-- Team member card with role and department
app "Team Member" {
  state member = "Bob Smith"

  column padding: 20px, gap: 16px {
    heading "Team Member"

    rect width: 320px, color: #faf5ff, radius: 12px, padding: 20px {
      column gap: 8px {
        text "{member}" font-size: 22px, font-weight: bold
        text "Product Designer" color: #64748b
        separator
        row gap: 12px {
          text "Projects: 24" color: #7c3aed
          text "Reviews: 89" color: #7c3aed
        }
        text "Design Team" color: #94a3b8, font-size: 13px
      }
    }
  }
}
