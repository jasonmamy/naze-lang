-- SaaS product onboarding wizard
app "SaaS Setup" {
  state step = 1
  state name = ""
  state agreed = false

  column padding: 24px, gap: 16px {
    heading "SaaS Setup" color: #2563eb

    row gap: 8px {
      rect width: 32px, height: 32px, color: #2563eb, radius: 16px {
        text "1" color: #ffffff, font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "2" font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "3" font-size: 14px
      }
    }

    match step {
      1: column gap: 12px {
        text "Welcome to CloudSync" font-size: 20px, font-weight: bold
        text "The easiest way to sync your data across devices." color: #64748b
        rect width: 140px, height: 40px, color: #2563eb, radius: 8px {
          text "Get Started" color: #ffffff
          on click: set step = 2
        }
      }
      2: column gap: 12px {
        text "Create Your Workspace" font-size: 20px, font-weight: bold
        text "Give your workspace a name to get started." color: #64748b
        input bind: name, placeholder: "Workspace name"
        rect width: 100px, height: 40px, color: #2563eb, radius: 8px {
          text "Next" color: #ffffff
          on click: set step = 3
        }
      }
      3: column gap: 12px {
        text "Terms and Conditions" font-size: 20px, font-weight: bold
        text "Please review and accept our terms." color: #64748b
        checkbox bind: agreed, label: "I accept the terms"
        rect width: 120px, height: 40px, color: #2563eb, radius: 8px {
          text "Complete" color: #ffffff
          on click: set step = 1
        }
      }
      _: text "Unknown step"
    }
  }
}
