-- Celsius to Fahrenheit converter
app "Temperature" {
  state celsius = 20
  state offset = 32
  computed fahrenheit = celsius * 9 / 5 + offset

  column padding: 20px, gap: 16px {
    heading "Temperature"
    text "Celsius: {celsius}" font-size: 18px
    text "Offset: {offset}" color: #64748b
    text "Fahrenheit: {fahrenheit}" font-size: 24px, color: #ef4444

    row gap: 8px {
      rect width: 80px, height: 36px, color: #ef4444, radius: 4px {
        text "+" color: #ffffff
        on click: set celsius = celsius + 1
      }
      rect width: 80px, height: 36px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set celsius = 20
      }
    }
  }
}
