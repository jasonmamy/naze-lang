-- Home renovation project board
app "Renovation Board" {
  state todo = [{title: "Get quotes", tag: "planning"}, {title: "Buy materials", tag: "supplies"}]
  state doing = [{title: "Paint walls", tag: "labor"}]
  state done = [{title: "Floor install", tag: "labor"}]
  computed todo-count = todo | count
  computed doing-count = doing | count
  computed done-count = done | count

  column padding: 24px, gap: 16px {
    heading "Renovation Board" color: #ea580c

    row gap: 16px {
      column gap: 8px {
        row gap: 4px {
          rect width: 10px, height: 10px, color: #fdba74, radius: 5px
          text "To Do ({todo-count})" font-weight: bold, font-size: 14px
        }
        each card in todo {
          rect padding: 12px, color: #fff7ed, radius: 8px {
            text "{card.title}" font-size: 14px
            text "{card.tag}" color: #94a3b8, font-size: 11px
          }
        }
      }

      column gap: 8px {
        row gap: 4px {
          rect width: 10px, height: 10px, color: #f97316, radius: 5px
          text "In Progress ({doing-count})" font-weight: bold, font-size: 14px
        }
        each card in doing {
          rect padding: 12px, color: #fff7ed, radius: 8px {
            text "{card.title}" font-size: 14px
            text "{card.tag}" color: #94a3b8, font-size: 11px
          }
        }
      }

      column gap: 8px {
        row gap: 4px {
          rect width: 10px, height: 10px, color: #16a34a, radius: 5px
          text "Done ({done-count})" font-weight: bold, font-size: 14px
        }
        each card in done {
          rect padding: 12px, color: #fff7ed, radius: 8px {
            text "{card.title}" font-size: 14px
            text "{card.tag}" color: #94a3b8, font-size: 11px
          }
        }
      }
    }
  }
}
