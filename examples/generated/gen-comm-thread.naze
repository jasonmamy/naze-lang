-- Message thread with replies
app "Message Thread" {
  state items = [{sender: "Dave", msg: "Has anyone seen the report?"}, {sender: "Eve", msg: "I uploaded it yesterday"}, {sender: "Frank", msg: "Thanks, found it!"}]
  state reply = ""
  state replied = "idle"
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Message Thread"
    text "{total} messages" color: #64748b

    input bind: reply, placeholder: "Type reply..."

    rect width: 100px, height: 40px, color: #6366f1, radius: 8px {
      text "Reply" color: #ffffff
      on click: set replied = "replied"
    }

    if replied == "replied" {
      text "Reply sent!" color: #16a34a
    }

    each m in items {
      row padding: 12px, color: #f0f9ff, radius: 4px, gap: 8px {
        text "{m.sender}" font-weight: bold
        text "{m.msg}" color: #64748b
      }
    }
  }
}
