-- Shipping address form with street and zip
app "Shipping Address" {
  state street = ""
  state city = ""
  state state-name = ""
  state zip = ""
  state saved = false

  column padding: 20px, gap: 12px {
    heading "Shipping Address"

    input bind: street, placeholder: "Street Address"
    input bind: city, placeholder: "City"
    input bind: state-name, placeholder: "State"
    input bind: zip, placeholder: "ZIP Code"

    rect width: 120px, height: 40px, color: #2563eb, radius: 8px {
      text "Save" color: #ffffff
      on click: set saved = true
    }

    if saved {
      text "Address saved!" color: #16a34a
    }
  }
}
