-- Classic Caesar salad recipe card
app "Caesar Salad" {
  state servings = 2
  state ingredients = [{name: "Romaine", amount: "2 heads"}, {name: "Croutons", amount: "1 cup"}, {name: "Parmesan", amount: "50g"}, {name: "Dressing", amount: "4 tbsp"}]
  state current-step = 1

  column padding: 20px, gap: 16px {
    heading "Caesar Salad"
    text "American | 15 min | {servings} servings" color: #64748b

    rect padding: 16px, color: #f0fdf4, radius: 8px {
      text "Ingredients" font-weight: bold, font-size: 18px
      each item in ingredients {
        text "- {item.name}: {item.amount}" color: #374151
      }
    }

    rect padding: 16px, color: #f8fafc, radius: 8px {
      text "Step {current-step}" font-weight: bold, font-size: 18px, color: #22c55e
      text "Wash lettuce, make dressing, toss with croutons and cheese" color: #374151
    }

    row gap: 8px {
      rect width: 100px, height: 36px, color: #22c55e, radius: 4px {
        text "Next Step" color: #ffffff
        on click: set current-step = current-step + 1
      }
      rect width: 100px, height: 36px, color: #e2e8f0, radius: 4px {
        text "Reset"
        on click: set current-step = 1
      }
    }
  }
}
