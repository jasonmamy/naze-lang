-- BMI calculator from weight and height
app "BMI" {
  state weight = 70
  state height = 170
  computed bmi = weight * 10000 / (height * height)

  column padding: 20px, gap: 16px {
    heading "BMI"
    text "Weight (kg): {weight}" font-size: 18px
    text "Height (cm): {height}" color: #64748b
    text "BMI: {bmi}" font-size: 24px, color: #8b5cf6

    row gap: 8px {
      rect width: 80px, height: 36px, color: #8b5cf6, radius: 4px {
        text "+" color: #ffffff
        on click: set weight = weight + 1
      }
      rect width: 80px, height: 36px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set weight = 70
      }
    }
  }
}
