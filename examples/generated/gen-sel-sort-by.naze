-- Data sort order selector
app "Sort Order" {
  state choice = "name"

  column padding: 20px, gap: 16px {
    heading "Sort Order"

    select bind: choice {
      option "By Name" value: "name"
      option "By Date" value: "date"
      option "By Rating" value: "rating"
    }

    match choice {
      "name": rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Sorted alphabetically by name" color: #2563eb
      }
      "date": rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Sorted by most recent first" color: #059669
      }
      "rating": rect padding: 16px, color: #fef3c7, radius: 8px {
        text "Sorted by highest rating first" color: #d97706
      }
      _: text "Select an option" color: #94a3b8
    }
  }
}
