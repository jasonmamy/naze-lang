-- Empty project list state page
app "No Projects" {
  column padding: 40px, gap: 20px {
    spacer height: 40px

    rect width: 80px, height: 80px, color: #f5f3ff, radius: 40px {
      text "+" font-size: 32px, color: #7c3aed
    }

    heading "No Projects Yet" font-size: 22px, color: #1e293b
    text "Create your first project to get started." color: #64748b, font-size: 16px
    text "Projects help organize your work." color: #94a3b8, font-size: 14px

    rect width: 160px, height: 44px, color: #7c3aed, radius: 8px {
      text "New Project" color: #ffffff, font-size: 15px
      on click: navigate "/projects/new"
    }
  }
}
