-- Favorite pet type survey
app "Pet Poll" {
  state opt-a = 40
  state opt-b = 38
  state opt-c = 12
  computed total-votes = opt-a + opt-b + opt-c

  column padding: 24px, gap: 16px {
    heading "Pet Poll" color: #ec4899
    text "Cats or dogs?" font-size: 18px
    text "Total votes: {total-votes}" color: #64748b

    row gap: 8px {
      rect width: 120px, height: 40px, color: #ec4899, radius: 8px {
        text "Dogs ({opt-a})" color: #ffffff
        on click: set opt-a = opt-a + 1
      }
      rect width: 120px, height: 40px, color: #64748b, radius: 8px {
        text "Cats ({opt-b})" color: #ffffff
        on click: set opt-b = opt-b + 1
      }
      rect width: 120px, height: 40px, color: #94a3b8, radius: 8px {
        text "Birds ({opt-c})" color: #ffffff
        on click: set opt-c = opt-c + 1
      }
    }

    column gap: 4px {
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Dogs" font-size: 12px
      }
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Cats" font-size: 12px
      }
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Birds" font-size: 12px
      }
    }
  }
}
