-- Feature request form with title and reason
app "Request" {
  state feature = ""
  state reason = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Request"

    input bind: feature, placeholder: "Feature Name"
    input bind: reason, placeholder: "Why do you need this?"

    rect width: 120px, height: 40px, color: #d946ef, radius: 8px {
      text "Request" color: #ffffff
      on click: set submitted = true
    }

    if submitted {
      text "Request logged!" color: #16a34a
    }
  }
}
