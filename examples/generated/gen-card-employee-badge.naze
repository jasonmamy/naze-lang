-- Employee ID badge card
app "Employee Badge" {
  state emp-name = "David Lee"

  column padding: 20px, gap: 16px {
    heading "Employee Badge"

    rect width: 320px, color: #fff7ed, radius: 12px, padding: 20px {
      column gap: 8px {
        text "{emp-name}" font-size: 22px, font-weight: bold
        text "ID: EMP-4821" color: #64748b
        separator
        row gap: 12px {
          text "Dept: Engineering" color: #c2410c
          text "Floor: 3" color: #c2410c
        }
        text "Access Level: A2" color: #94a3b8, font-size: 13px
      }
    }
  }
}
