-- Property management tenant card
app "Tenant Card" {
  state tenant = "Sarah Kim"

  column padding: 20px, gap: 16px {
    heading "Tenant Card"

    rect width: 320px, color: #f1f5f9, radius: 12px, padding: 20px {
      column gap: 8px {
        text "{tenant}" font-size: 22px, font-weight: bold
        text "Apt 4B - Maple Heights" color: #64748b
        separator
        row gap: 12px {
          text "Lease: 12mo" color: #475569
          text "Rent: $1850" color: #475569
        }
        text "Move-in: Jan 2024" color: #94a3b8, font-size: 13px
      }
    }
  }
}
