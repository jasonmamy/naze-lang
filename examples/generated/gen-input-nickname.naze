-- Display name editor
app "Nickname" {
  state nickname = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Nickname"
    text "Set your display name" color: #64748b

    input bind: nickname, placeholder: "Enter nickname"

    row gap: 8px {
      rect width: 100px, height: 36px, color: #06b6d4, radius: 4px {
        text "Save" color: #ffffff
        on click: set submitted = true
      }
      rect width: 80px, height: 36px, color: #94a3b8, radius: 4px {
        text "Clear" color: #ffffff
        on click: set nickname = ""
        on click: set submitted = false
      }
    }

    if submitted {
      rect padding: 12px, color: #ecfeff, radius: 8px {
        text "Name set to: {nickname}" font-weight: bold, color: #06b6d4
      }
    }
  }
}
