-- Service health indicator
app "Service Health" {
  state status = "healthy"

  column padding: 20px, gap: 16px {
    heading "Service Health"

    row gap: 8px {
      rect width: 80px, height: 28px, color: #16a34a, radius: 12px {
        text "healthy" color: #ffffff, font-size: 12px
        on click: set status = "healthy"
      }
      rect width: 80px, height: 28px, color: #f59e0b, radius: 12px {
        text "degraded" color: #ffffff, font-size: 12px
        on click: set status = "degraded"
      }
      rect width: 80px, height: 28px, color: #ef4444, radius: 12px {
        text "outage" color: #ffffff, font-size: 12px
        on click: set status = "outage"
      }
    }

    text "Current: {status}" font-size: 18px, font-weight: bold
  }
}
