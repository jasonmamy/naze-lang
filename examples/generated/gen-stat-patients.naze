-- Clinic patient statistics
app "Clinic Stats" {
  state patients = 45
  state appointments = 12

  column padding: 20px, gap: 16px {
    heading "Clinic Stats"
    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #faf5ff, radius: 8px {
        text "Patients" color: #64748b, font-size: 12px
        text "{patients}" font-size: 24px, color: #a855f7
      }
      rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Appts Today" color: #64748b, font-size: 12px
        text "{appointments}" font-size: 24px, color: #059669
      }
    }
    row gap: 8px {
      rect width: 80px, height: 32px, color: #a855f7, radius: 4px {
        text "+1" color: #ffffff
        on click: set patients = patients + 1
      }
      rect width: 80px, height: 32px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set patients = 45
      }
    }
  }
}
