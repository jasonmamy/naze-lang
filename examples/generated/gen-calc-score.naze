-- Quiz score percentage calculator
app "Quiz Score" {
  state correct = 0
  state total = 10
  computed percent = correct * 100 / total

  column padding: 20px, gap: 16px {
    heading "Quiz Score"
    text "Correct: {correct}" font-size: 18px
    text "Total: {total}" color: #64748b
    text "Score: {percent}" font-size: 24px, color: #16a34a

    row gap: 8px {
      rect width: 80px, height: 36px, color: #16a34a, radius: 4px {
        text "+" color: #ffffff
        on click: set correct = correct + 1
      }
      rect width: 80px, height: 36px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set correct = 0
      }
    }
  }
}
