-- Weather conditions dashboard
app "Weather" {
  state temp = 22
  state humidity = 65
  state wind = 15
  state uv-index = 6

  column padding: 20px, gap: 16px {
    heading "Weather"

    grid columns: 2, gap: 16px {
      rect padding: 16px, color: #fff7ed, radius: 8px {
        text "Temp (C)" color: #64748b, font-size: 14px
        text "{temp}" font-size: 28px
      }
      rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Humidity %" color: #64748b, font-size: 14px
        text "{humidity}" font-size: 28px
      }
      rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Wind (km/h)" color: #64748b, font-size: 14px
        text "{wind}" font-size: 28px
      }
      rect padding: 16px, color: #fefce8, radius: 8px {
        text "UV Index" color: #64748b, font-size: 14px
        text "{uv-index}" font-size: 28px
      }
    }
  }
}
