-- Chef profile with recipe link
app "Chef Profile" {
  state username = "chef_marco"
  state bio = "Italian cuisine enthusiast"
  state followers = 2100
  state following = 150
  computed ratio = followers / following

  column padding: 24px, gap: 16px {
    heading "Chef Profile"

    row gap: 16px {
      rect width: 80px, height: 80px, color: #ef4444, radius: 40px {
        text "C" color: #ffffff, font-size: 32px
      }
      column gap: 4px {
        text "{username}" font-size: 22px, font-weight: bold
        text "{bio}" color: #64748b
      }
    }

    grid columns: 3, gap: 12px {
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Followers" color: #64748b, font-size: 12px
        text "{followers}" font-size: 20px, color: #dc2626
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Following" color: #64748b, font-size: 12px
        text "{following}" font-size: 20px, color: #dc2626
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Ratio" color: #64748b, font-size: 12px
        text "{ratio}" font-size: 20px, color: #dc2626
      }
    }

    separator

    rect padding: 12px, color: #fef2f2, radius: 8px {
      link "Recipes" href: "https://allrecipes.com"
    }
  }
}
