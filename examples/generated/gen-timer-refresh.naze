-- Auto-refresh counter every 5 seconds
app "Auto Refresh" {
  state refreshes = 0
  state active = false

  timer tick: every 5s {
    set refreshes = refreshes + 1
  }

  column padding: 20px, gap: 16px {
    heading "Auto Refresh"
    text "{refreshes} refreshes" font-size: 48px, color: #0ea5e9

    row gap: 8px {
      rect width: 100px, height: 40px, color: #16a34a, radius: 8px {
        text "Start" color: #ffffff
        on click: set active = true
      }
      rect width: 100px, height: 40px, color: #dc2626, radius: 8px {
        text "Reset" color: #ffffff
        on click: set refreshes = 0
      }
    }
  }
}
