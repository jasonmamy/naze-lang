-- Language selector with preview
app "Language" {
  state choice = "en"

  column padding: 20px, gap: 16px {
    heading "Language"

    select bind: choice {
      option "English" value: "en"
      option "Spanish" value: "es"
      option "French" value: "fr"
    }

    match choice {
      "en": rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Hello! Welcome." color: #2563eb
      }
      "es": rect padding: 16px, color: #fef3c7, radius: 8px {
        text "Hola! Bienvenido." color: #d97706
      }
      "fr": rect padding: 16px, color: #fce7f3, radius: 8px {
        text "Bonjour! Bienvenue." color: #be185d
      }
      _: text "Select an option" color: #94a3b8
    }
  }
}
