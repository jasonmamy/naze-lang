-- Search form with query and category
app "Search" {
  state query = ""
  state category = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Search"

    input bind: query, placeholder: "Search term"
    input bind: category, placeholder: "Category"

    rect width: 120px, height: 40px, color: #0ea5e9, radius: 8px {
      text "Search" color: #ffffff
      on click: set submitted = true
    }

    if submitted {
      text "Searching..." color: #16a34a
    }
  }
}
