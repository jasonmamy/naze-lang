-- Daily meeting schedule with participants
app "Meeting Schedule" {
  state events = [{slot: "1", time: "09:00", meeting: "All Hands", attendees: "Full team"}, {slot: "2", time: "11:00", meeting: "1-on-1", attendees: "Manager"}, {slot: "3", time: "15:00", meeting: "Code Review", attendees: "Dev team"}]
  computed event-count = events | count

  column padding: 20px, gap: 16px {
    heading "Meeting Schedule"
    text "{event-count} meetings today" color: #64748b

    each evt in events | sort-by slot {
      row padding: 12px, color: #f0f9ff, radius: 8px, gap: 12px {
        rect width: 60px, height: 40px, color: #0284c7, radius: 4px {
          text "{evt.time}" color: #ffffff, font-size: 12px
        }
        column gap: 2px {
          text "{evt.meeting}" font-weight: bold
          text "{evt.attendees}" color: #64748b
        }
      }
    }
  }
}
