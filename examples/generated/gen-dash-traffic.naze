-- Web traffic analytics dashboard
app "Traffic" {
  state visitors = 8400
  state page-views = 24000
  state bounce-rate = 35
  state avg-time = 180

  column padding: 20px, gap: 16px {
    heading "Traffic"

    grid columns: 2, gap: 16px {
      rect padding: 16px, color: #f0f9ff, radius: 8px {
        text "Visitors" color: #64748b, font-size: 14px
        text "{visitors}" font-size: 28px
      }
      rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Page Views" color: #64748b, font-size: 14px
        text "{page-views}" font-size: 28px
      }
      rect padding: 16px, color: #fefce8, radius: 8px {
        text "Bounce %" color: #64748b, font-size: 14px
        text "{bounce-rate}" font-size: 28px
      }
      rect padding: 16px, color: #fdf2f8, radius: 8px {
        text "Avg Time (s)" color: #64748b, font-size: 14px
        text "{avg-time}" font-size: 28px
      }
    }
  }
}
