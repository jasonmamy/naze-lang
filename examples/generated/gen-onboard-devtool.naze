-- Developer tool onboarding wizard
app "Dev Tool Setup" {
  state step = 1
  state name = ""
  state agreed = false

  column padding: 24px, gap: 16px {
    heading "Dev Tool Setup" color: #475569

    row gap: 8px {
      rect width: 32px, height: 32px, color: #475569, radius: 16px {
        text "1" color: #ffffff, font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "2" font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "3" font-size: 14px
      }
    }

    match step {
      1: column gap: 12px {
        text "Welcome, Developer" font-size: 20px, font-weight: bold
        text "Ship faster with our developer platform." color: #64748b
        rect width: 140px, height: 40px, color: #475569, radius: 8px {
          text "Get Started" color: #ffffff
          on click: set step = 2
        }
      }
      2: column gap: 12px {
        text "Project Name" font-size: 20px, font-weight: bold
        text "What are you building today?" color: #64748b
        input bind: name, placeholder: "Project name"
        rect width: 100px, height: 40px, color: #475569, radius: 8px {
          text "Next" color: #ffffff
          on click: set step = 3
        }
      }
      3: column gap: 12px {
        text "API Terms of Use" font-size: 20px, font-weight: bold
        text "Review our API usage policy." color: #64748b
        checkbox bind: agreed, label: "I accept the API terms"
        rect width: 120px, height: 40px, color: #475569, radius: 8px {
          text "Complete" color: #ffffff
          on click: set step = 1
        }
      }
      _: text "Unknown step"
    }
  }
}
