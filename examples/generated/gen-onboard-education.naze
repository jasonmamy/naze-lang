-- Online course enrollment onboarding
app "Course Setup" {
  state step = 1
  state name = ""
  state agreed = false

  column padding: 24px, gap: 16px {
    heading "Course Setup" color: #7c3aed

    row gap: 8px {
      rect width: 32px, height: 32px, color: #7c3aed, radius: 16px {
        text "1" color: #ffffff, font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "2" font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "3" font-size: 14px
      }
    }

    match step {
      1: column gap: 12px {
        text "Start Learning" font-size: 20px, font-weight: bold
        text "Thousands of courses at your fingertips." color: #64748b
        rect width: 140px, height: 40px, color: #7c3aed, radius: 8px {
          text "Get Started" color: #ffffff
          on click: set step = 2
        }
      }
      2: column gap: 12px {
        text "Your Details" font-size: 20px, font-weight: bold
        text "Tell us your display name." color: #64748b
        input bind: name, placeholder: "Display name"
        rect width: 100px, height: 40px, color: #7c3aed, radius: 8px {
          text "Next" color: #ffffff
          on click: set step = 3
        }
      }
      3: column gap: 12px {
        text "Academic Integrity" font-size: 20px, font-weight: bold
        text "We value honest learning." color: #64748b
        checkbox bind: agreed, label: "I pledge academic integrity"
        rect width: 120px, height: 40px, color: #7c3aed, radius: 8px {
          text "Complete" color: #ffffff
          on click: set step = 1
        }
      }
      _: text "Unknown step"
    }
  }
}
