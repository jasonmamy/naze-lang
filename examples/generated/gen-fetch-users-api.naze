-- User list from remote API
app "API Users" {
  data users: fetch "https://api.example.com/users"

  column padding: 20px, gap: 16px {
    heading "API Users"

    if users.loading {
      text "Loading users..." color: #64748b
    }

    if users.error {
      text "Failed to load users" color: #dc2626
    }

    if users.data {
      text "users loaded successfully" color: #16a34a
      each user in users.data {
        row padding: 8px, color: #eff6ff, radius: 4px {
          text "{user.name}"
        }
      }
    }
  }
}
