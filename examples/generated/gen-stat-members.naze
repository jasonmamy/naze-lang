-- Team member statistics
app "Team Stats" {
  state members = 15
  state projects = 8

  column padding: 20px, gap: 16px {
    heading "Team Stats"
    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #f0fdf4, radius: 8px {
        text "Members" color: #64748b, font-size: 12px
        text "{members}" font-size: 24px, color: #22c55e
      }
      rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Projects" color: #64748b, font-size: 12px
        text "{projects}" font-size: 24px, color: #3b82f6
      }
    }
    row gap: 8px {
      rect width: 80px, height: 32px, color: #22c55e, radius: 4px {
        text "+1" color: #ffffff
        on click: set members = members + 1
      }
      rect width: 80px, height: 32px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set members = 15
      }
    }
  }
}
