-- Auto repair shop invoice
app "Auto Repair" {
  state item1-qty = 1
  state item2-qty = 2
  state item1-price = 50
  state item2-price = 80
  state tax-rate = 6
  computed subtotal = item1-qty * item1-price + item2-qty * item2-price
  computed tax = subtotal * tax-rate / 100
  computed total = subtotal + tax

  column padding: 24px, gap: 16px {
    heading "Auto Repair" color: #475569

    rect padding: 16px, color: #f8fafc, radius: 8px {
      column gap: 8px {
        text "QuickFix Auto" font-size: 18px, font-weight: bold
        text "100 Garage Rd" color: #64748b, font-size: 13px
        separator
        text "Invoice #QF-5511" color: #94a3b8, font-size: 12px
      }
    }

    column gap: 4px {
      row gap: 8px {
        text "Oil Change" font-weight: bold
        spacer
        text "{item1-qty} x ${item1-price}" color: #64748b
      }
      row gap: 8px {
        text "Brake Pads" font-weight: bold
        spacer
        text "{item2-qty} x ${item2-price}" color: #64748b
      }
    }

    separator

    column gap: 4px {
      row gap: 8px {
        text "Subtotal" color: #64748b
        spacer
        text "${subtotal}"
      }
      row gap: 8px {
        text "Tax ({tax-rate}%)" color: #64748b
        spacer
        text "${tax}"
      }
      row gap: 8px {
        text "Total" font-weight: bold, font-size: 18px
        spacer
        text "${total}" font-weight: bold, font-size: 18px, color: #475569
      }
    }
  }
}
