-- Project list with deadlines
app "Projects" {
  state items = [{name: "Alpha", deadline: "Mar 15"}, {name: "Beta", deadline: "Apr 1"}, {name: "Gamma", deadline: "May 10"}]
  state view = "active"
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Projects"
    text "{total} projects" color: #64748b

    row gap: 8px {
      rect width: 80px, height: 32px, color: #3b82f6, radius: 4px {
        text "Active" color: #ffffff
        on click: set view = "active"
      }
      rect width: 80px, height: 32px, color: #94a3b8, radius: 4px {
        text "Archive" color: #ffffff
        on click: set view = "archive"
      }
    }

    each proj in items | sort-by name {
      row padding: 12px, color: #eff6ff, radius: 4px, gap: 12px {
        text "{proj.name}" font-weight: bold
        text "{proj.deadline}" color: #dc2626
      }
    }
  }
}
