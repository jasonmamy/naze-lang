-- Welcome toast for new users
app "Welcome Toast" {
  state show-toast = false
  state action-done = false

  column padding: 24px, gap: 16px {
    heading "Welcome Toast"
    text "You have just signed up." color: #64748b

    row gap: 8px {
      rect width: 120px, height: 40px, color: #ec4899, radius: 8px {
        text "Get Started" color: #ffffff
        on click: set show-toast = true
        on click: set action-done = true
      }
    }

    if show-toast {
      rect width: 340px, height: 48px, color: #fdf2f8, radius: 8px {
        row padding: 12px, gap: 12px {
          text "[*]" font-size: 16px
          text "Welcome! Let us set up your profile." color: #9d174d, font-size: 14px
          spacer
          rect width: 24px, height: 24px, radius: 4px {
            text "x" color: #9d174d, font-size: 12px
            on click: set show-toast = false
          }
        }
      }
    }
  }
}
