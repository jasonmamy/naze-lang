-- Email inbox with sender and subject
app "Email Inbox" {
  state items = [{from: "Alice", subject: "Meeting at 3pm"}, {from: "Bob", subject: "Code review needed"}, {from: "Carol", subject: "Lunch tomorrow?"}]
  state draft = ""
  state sent = "idle"
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Email Inbox"
    text "{total} emails" color: #64748b

    input bind: draft, placeholder: "New email..."

    rect width: 120px, height: 40px, color: #2563eb, radius: 8px {
      text "Compose" color: #ffffff
      on click: set sent = "sent"
    }

    if sent == "sent" {
      text "Email sent!" color: #16a34a
    }

    each email in items {
      row padding: 12px, color: #f8fafc, radius: 4px, gap: 8px {
        text "{email.from}" font-weight: bold
        text "{email.subject}" color: #64748b
      }
    }
  }
}
