-- IT helpdesk service ticket
app "IT Helpdesk" {
  state ticket-id = "IT-5560"
  state status = "In Progress"
  state priority = "Urgent"

  column padding: 24px, gap: 16px {
    heading "IT Helpdesk" color: #ea580c

    rect padding: 20px, color: #ffffff, radius: 12px {
      column gap: 12px {
        row gap: 8px {
          text "IT Request" font-weight: bold, font-size: 18px
          spacer
          rect padding: 6px, color: #fff7ed, radius: 4px {
            text "{status}" color: #ea580c, font-size: 12px
          }
        }

        separator

        row gap: 16px {
          column gap: 4px {
            text "ID" color: #94a3b8, font-size: 11px
            text "{ticket-id}" font-size: 14px
          }
          column gap: 4px {
            text "Priority" color: #94a3b8, font-size: 11px
            text "{priority}" font-size: 14px, color: #dc2626
          }
          column gap: 4px {
            text "Assignee" color: #94a3b8, font-size: 11px
            text "Dave K." font-size: 14px
          }
        }

        separator

        text "Laptop not connecting to corporate VPN." color: #334155
        text "User: Sarah M., Dept: Marketing, ext. 2401" color: #64748b, font-size: 13px
      }
    }

    match status {
      "In Progress": rect padding: 10px, color: #fff7ed, radius: 8px {
        text "Technician en route, ETA 15 min" color: #ea580c, font-size: 13px
      }
      _: text "Unknown status" color: #94a3b8
    }
  }
}
