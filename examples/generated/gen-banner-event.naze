-- Conference event announcement banner
app "Event Banner" {
  column {
    rect width: 800px, height: 280px, color: #0f172a, radius: 12px {
      column padding: 40px, gap: 12px {
        text "DevConf 2025" color: #f0abfc, font-size: 36px, font-weight: bold
        text "Join 5000+ developers. March 15-17." color: #d8b4fe, font-size: 16px
        rect width: 150px, height: 44px, color: #a855f7, radius: 8px {
          text "Register Now" color: #ffffff
        }
      }
    }
  }
}
