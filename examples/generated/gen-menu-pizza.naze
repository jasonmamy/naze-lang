-- Pizza parlor menu
app "Slice House" {
  state category = "Classics"
  state items = [{name: "Pepperoni", desc: "Mozzarella, pepperoni, oregano", price: "$18"}, {name: "BBQ Chicken", desc: "BBQ sauce, red onion, cilantro", price: "$20"}, {name: "Garlic Knots", desc: "Butter, parmesan, herbs", price: "$6"}]
  computed total-items = items | count

  column padding: 24px, gap: 16px {
    heading "Slice House" color: #dc2626

    row gap: 8px {
      rect padding: 8px, color: #dc2626, radius: 4px {
        text "Classics" color: #ffffff, font-size: 13px
        on click: set category = "Classics"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Specialty" font-size: 13px
        on click: set category = "Specialty"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Sides" font-size: 13px
        on click: set category = "Sides"
      }
    }

    text "{total-items} items on the menu" color: #94a3b8, font-size: 12px

    each item in items {
      rect padding: 12px, color: #fef2f2, radius: 8px {
        row gap: 8px {
          column gap: 2px {
            text "{item.name}" font-weight: bold
            text "{item.desc}" color: #64748b, font-size: 13px
          }
          spacer
          text "{item.price}" font-weight: bold, color: #dc2626
        }
      }
    }
  }
}
