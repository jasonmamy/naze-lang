-- Mentorship platform profile card
app "Mentor Profile" {
  state mentor = "James Park"

  column padding: 20px, gap: 16px {
    heading "Mentor Profile"

    rect width: 320px, color: #f0f9ff, radius: 12px, padding: 20px {
      column gap: 8px {
        text "{mentor}" font-size: 22px, font-weight: bold
        text "Engineering Manager" color: #64748b
        separator
        row gap: 12px {
          text "Mentees: 15" color: #0369a1
          text "Years: 12" color: #0369a1
        }
        text "Specializes in career growth" color: #94a3b8, font-size: 13px
      }
    }
  }
}
