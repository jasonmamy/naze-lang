-- New product launch announcement banner
app "Product Launch" {
  column {
    rect width: 800px, height: 300px, color: #6366f1, radius: 0px {
      column padding: 48px, gap: 12px {
        text "Introducing v3.0" color: #ffffff, font-size: 38px, font-weight: bold
        text "Completely redesigned from the ground up." color: #c7d2fe, font-size: 16px
        rect width: 170px, height: 44px, color: #ffffff, radius: 8px {
          text "Explore Features" color: #4f46e5
        }
      }
    }
  }
}
