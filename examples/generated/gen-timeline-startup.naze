-- Startup company milestone timeline
app "Startup Journey" {
  state events = [{time: "2024 Q1", title: "Founded", detail: "Team of 3 in garage"}, {time: "2024 Q3", title: "Seed Round", detail: "$500K raised"}, {time: "2025 Q1", title: "Product", detail: "MVP launched"}, {time: "2025 Q4", title: "Series A", detail: "$5M raised"}]
  computed total = events | count

  column padding: 24px, gap: 8px {
    heading "Startup Journey" color: #0891b2
    text "{total} events" color: #94a3b8, font-size: 12px

    each evt in events {
      row gap: 12px {
        column gap: 0px {
          rect width: 12px, height: 12px, color: #06b6d4, radius: 6px
          rect width: 2px, height: 40px, color: #e2e8f0
        }
        column gap: 2px {
          text "{evt.time}" color: #94a3b8, font-size: 11px
          text "{evt.title}" font-weight: bold
          text "{evt.detail}" color: #64748b, font-size: 13px
        }
      }
    }
  }
}
