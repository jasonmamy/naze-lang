-- Tag input for categorization
app "Add Tag" {
  state tag-name = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Add Tag"
    text "Add a tag to this item" color: #64748b

    input bind: tag-name, placeholder: "e.g. important"

    row gap: 8px {
      rect width: 100px, height: 36px, color: #7c3aed, radius: 4px {
        text "Add Tag" color: #ffffff
        on click: set submitted = true
      }
      rect width: 80px, height: 36px, color: #94a3b8, radius: 4px {
        text "Clear" color: #ffffff
        on click: set tag-name = ""
        on click: set submitted = false
      }
    }

    if submitted {
      rect padding: 12px, color: #f5f3ff, radius: 8px {
        text "Tagged: {tag-name}" font-weight: bold, color: #7c3aed
      }
    }
  }
}
