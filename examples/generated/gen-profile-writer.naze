-- Content writer profile page
app "Writer Profile" {
  state username = "john_writes"
  state bio = "Technical writer and blogger"
  state followers = 890
  state following = 420
  computed ratio = followers / following

  column padding: 24px, gap: 16px {
    heading "Writer Profile"

    row gap: 16px {
      rect width: 80px, height: 80px, color: #8b5cf6, radius: 40px {
        text "J" color: #ffffff, font-size: 32px
      }
      column gap: 4px {
        text "{username}" font-size: 22px, font-weight: bold
        text "{bio}" color: #64748b
      }
    }

    grid columns: 3, gap: 12px {
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Followers" color: #64748b, font-size: 12px
        text "{followers}" font-size: 20px, color: #7c3aed
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Following" color: #64748b, font-size: 12px
        text "{following}" font-size: 20px, color: #7c3aed
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Ratio" color: #64748b, font-size: 12px
        text "{ratio}" font-size: 20px, color: #7c3aed
      }
    }

    separator

    rect padding: 12px, color: #f5f3ff, radius: 8px {
      link "Blog" href: "https://medium.com"
    }
  }
}
