-- GitHub repositories from API
app "Repos" {
  data repos: fetch "/api/repos"

  column padding: 20px, gap: 16px {
    heading "Repos"

    if repos.loading {
      text "Loading repos..." color: #64748b
    }

    if repos.error {
      text "Failed to load repos" color: #dc2626
    }

    if repos.data {
      text "repos loaded successfully" color: #16a34a
      each repo in repos.data {
        row padding: 8px, color: #f8fafc, radius: 4px {
          text "{repo.name}"
        }
      }
    }
  }
}
