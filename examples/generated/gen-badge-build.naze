-- CI build status indicator
app "Build Status" {
  state status = "running"

  column padding: 20px, gap: 16px {
    heading "Build Status"

    row gap: 8px {
      rect width: 80px, height: 28px, color: #16a34a, radius: 12px {
        text "passed" color: #ffffff, font-size: 12px
        on click: set status = "passed"
      }
      rect width: 80px, height: 28px, color: #2563eb, radius: 12px {
        text "running" color: #ffffff, font-size: 12px
        on click: set status = "running"
      }
      rect width: 80px, height: 28px, color: #ef4444, radius: 12px {
        text "failed" color: #ffffff, font-size: 12px
        on click: set status = "failed"
      }
    }

    text "Current: {status}" font-size: 18px, font-weight: bold
  }
}
