-- Temperature controller
app "Thermostat" {
  state target = 20
  state mode = "heat"

  column padding: 20px, gap: 16px {
    heading "Thermostat"
    text "{target}" font-size: 24px, color: #ef4444
    text "{mode}" color: #64748b

    row gap: 8px {
      rect width: 80px, height: 40px, color: #ef4444, radius: 8px {
        text "Warmer" color: #ffffff
        on click: set target = target + 1
      }
      rect width: 80px, height: 40px, color: #64748b, radius: 8px {
        text "Cooler" color: #ffffff
        on click: set mode = "cool"
      }
      rect width: 80px, height: 40px, color: #e2e8f0, radius: 8px {
        text "Reset"
        on click: set target = 20
      }
    }
  }
}
