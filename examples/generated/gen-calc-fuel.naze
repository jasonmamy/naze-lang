-- Fuel cost estimator
app "Fuel Cost" {
  state distance-km = 200
  state per-liter = 8
  computed cost = distance-km * per-liter / 100

  column padding: 20px, gap: 16px {
    heading "Fuel Cost"
    text "Distance: {distance-km}" font-size: 18px
    text "L/100km: {per-liter}" color: #64748b
    text "Cost: {cost}" font-size: 24px, color: #f97316

    row gap: 8px {
      rect width: 80px, height: 36px, color: #f97316, radius: 4px {
        text "+" color: #ffffff
        on click: set distance-km = distance-km + 1
      }
      rect width: 80px, height: 36px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set distance-km = 200
      }
    }
  }
}
