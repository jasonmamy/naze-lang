-- Vegan restaurant menu
app "Green Plate" {
  state category = "Mains"
  state items = [{name: "Tempeh Steak", desc: "Marinated, grilled, chimichurri", price: "$16"}, {name: "Buddha Bowl", desc: "Quinoa, avocado, tahini", price: "$14"}, {name: "Berry Blast", desc: "Mixed berries, banana, oat milk", price: "$8"}]
  computed total-items = items | count

  column padding: 24px, gap: 16px {
    heading "Green Plate" color: #16a34a

    row gap: 8px {
      rect padding: 8px, color: #16a34a, radius: 4px {
        text "Mains" color: #ffffff, font-size: 13px
        on click: set category = "Mains"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Bowls" font-size: 13px
        on click: set category = "Bowls"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Smoothies" font-size: 13px
        on click: set category = "Smoothies"
      }
    }

    text "{total-items} items on the menu" color: #94a3b8, font-size: 12px

    each item in items {
      rect padding: 12px, color: #f0fdf4, radius: 8px {
        row gap: 8px {
          column gap: 2px {
            text "{item.name}" font-weight: bold
            text "{item.desc}" color: #64748b, font-size: 13px
          }
          spacer
          text "{item.price}" font-weight: bold, color: #16a34a
        }
      }
    }
  }
}
