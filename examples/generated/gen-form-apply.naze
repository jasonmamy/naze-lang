-- Job application form with name and cover letter
app "Apply" {
  state applicant = ""
  state cover = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Apply"

    input bind: applicant, placeholder: "Your Name"
    input bind: cover, placeholder: "Cover Letter"

    rect width: 120px, height: 40px, color: #3b82f6, radius: 8px {
      text "Apply" color: #ffffff
      on click: set submitted = true
    }

    if submitted {
      text "Application sent!" color: #16a34a
    }
  }
}
