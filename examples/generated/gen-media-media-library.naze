-- Media library with file types
app "Media Library" {
  state items = [{name: "vacation.mp4", type: "Video"}, {name: "song.mp3", type: "Audio"}, {name: "photo.jpg", type: "Image"}, {name: "doc.pdf", type: "Document"}]
  state now-playing = "none"
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Media Library"
    text "{total} files" color: #64748b

    if now-playing != "none" {
      rect padding: 12px, color: #1d4ed8, radius: 8px {
        text "Now: {now-playing}" color: #ffffff, font-size: 18px
      }
    }

    each file in items {
      row padding: 12px, color: #eff6ff, radius: 8px, gap: 12px {
        text "{file.name}" font-weight: bold
        text "{file.type}" color: #64748b
        rect width: 60px, height: 28px, color: #2563eb, radius: 4px {
          text "Open" color: #ffffff
          on click: set now-playing = "{file.name}"
        }
      }
    }
  }
}
