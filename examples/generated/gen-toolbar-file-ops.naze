-- File operations toolbar with CRUD actions
app "File Manager Bar" {
  state active-tool = "new"

  column gap: 0px {
    rect width: 600px, height: 52px, color: #f1f5f9 {
      row padding: 8px, gap: 6px {
        rect width: 36px, height: 36px, color: #2563eb, radius: 6px {
          text "+" color: #ffffff, font-size: 14px
          on click: set active-tool = "new"
        }
        rect width: 36px, height: 36px, color: #16a34a, radius: 6px {
          text "O" color: #ffffff, font-size: 14px
          on click: set active-tool = "open"
        }
        rect width: 36px, height: 36px, color: #7c3aed, radius: 6px {
          text "S" color: #ffffff, font-size: 14px
          on click: set active-tool = "save"
        }
        rect width: 36px, height: 36px, color: #f59e0b, radius: 6px {
          text "C" color: #ffffff, font-size: 14px
          on click: set active-tool = "copy"
        }
        spacer
        rect width: 36px, height: 36px, color: #ef4444, radius: 6px {
          text "D" color: #ffffff, font-size: 14px
          on click: set active-tool = "delete"
        }
      }
    }

    column padding: 20px, gap: 8px {
      text "Tool: {active-tool}" font-weight: bold, font-size: 16px
      match active-tool {
        "new": text "Create a new file." color: #64748b
        "open": text "Open an existing file." color: #64748b
        "save": text "Save the current file." color: #64748b
        "copy": text "Copy the selected file." color: #64748b
        "delete": text "Delete the selected file." color: #64748b
        _: text "Select a tool" color: #94a3b8
      }
    }
  }
}
