-- Extreme cold weather warning
app "Cold Snap" {
  state temp = -28
  state feels-like = -38
  state humidity = 60
  state wind = 30
  state condition = "Extreme Cold"

  column padding: 24px, gap: 16px, color: #f0f9ff {
    heading "Winnipeg Weather" color: #0369a1

    row gap: 16px {
      rect width: 80px, height: 80px, color: #bae6fd, radius: 12px {
        text "ICE" font-size: 36px
      }
      column gap: 4px {
        text "{temp}C" font-size: 48px, font-weight: bold, color: #0369a1
        text "{condition}" color: #64748b, font-size: 16px
      }
    }

    grid columns: 3, gap: 12px {
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Feels Like" color: #64748b, font-size: 11px
        text "{feels-like}C" font-size: 18px
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Humidity" color: #64748b, font-size: 11px
        text "{humidity}%" font-size: 18px
      }
      rect padding: 12px, color: #f1f5f9, radius: 8px {
        text "Wind" color: #64748b, font-size: 11px
        text "{wind} km/h" font-size: 18px
      }
    }

    separator

    text "Forecast: Windchill warning in effect until Thursday" color: #94a3b8, font-size: 13px
  }
}
