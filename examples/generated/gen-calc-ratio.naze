-- Ratio calculator
app "Ratio" {
  state part = 25
  state whole = 100
  computed ratio = part * 100 / whole

  column padding: 20px, gap: 16px {
    heading "Ratio"
    text "Part: {part}" font-size: 18px
    text "Whole: {whole}" color: #64748b
    text "Ratio %: {ratio}" font-size: 24px, color: #a855f7

    row gap: 8px {
      rect width: 80px, height: 36px, color: #a855f7, radius: 4px {
        text "+" color: #ffffff
        on click: set part = part + 1
      }
      rect width: 80px, height: 36px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set part = 25
      }
    }
  }
}
