-- Feature request ticket tracker
app "Feature Request" {
  state ticket-id = "FEAT-0089"
  state status = "In Review"
  state priority = "Medium"

  column padding: 24px, gap: 16px {
    heading "Feature Request" color: #7c3aed

    rect padding: 20px, color: #ffffff, radius: 12px {
      column gap: 12px {
        row gap: 8px {
          text "Feature Request" font-weight: bold, font-size: 18px
          spacer
          rect padding: 6px, color: #f5f3ff, radius: 4px {
            text "{status}" color: #7c3aed, font-size: 12px
          }
        }

        separator

        row gap: 16px {
          column gap: 4px {
            text "ID" color: #94a3b8, font-size: 11px
            text "{ticket-id}" font-size: 14px
          }
          column gap: 4px {
            text "Priority" color: #94a3b8, font-size: 11px
            text "{priority}" font-size: 14px, color: #f59e0b
          }
          column gap: 4px {
            text "Votes" color: #94a3b8, font-size: 11px
            text "47" font-size: 14px
          }
        }

        separator

        text "Add dark mode support to the dashboard." color: #334155
        text "Requested by: 12 users in last 30 days" color: #64748b, font-size: 13px
      }
    }

    match status {
      "In Review": rect padding: 10px, color: #f5f3ff, radius: 8px {
        text "Under review by product team" color: #7c3aed, font-size: 13px
      }
      _: text "Unknown status" color: #94a3b8
    }
  }
}
