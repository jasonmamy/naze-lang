-- News site with latest, trending, and categories
app "News" {
  column padding: 20px, gap: 16px {
    heading "News"
    text "Breaking news"
    link "Latest", to: "/latest"
    link "Trending", to: "/trending"
    link "Categories", to: "/categories"
  }
}

page "/latest" {
  column padding: 20px {
    heading "Latest News"
    text "Most recent stories"
    link "Back to Home", to: "/"
  }
}

page "/trending" {
  column padding: 20px {
    heading "Trending"
    text "Popular stories"
    link "Back to Home", to: "/"
  }
}

page "/categories" {
  column padding: 20px {
    heading "Categories"
    text "News by topic"
    link "Back to Home", to: "/"
  }
}
