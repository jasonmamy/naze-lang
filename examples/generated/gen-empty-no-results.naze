-- Empty search results state page
app "No Results" {
  column padding: 40px, gap: 20px {
    spacer height: 40px

    rect width: 80px, height: 80px, color: #f1f5f9, radius: 40px {
      text "?" font-size: 32px, color: #94a3b8
    }

    heading "No Results Found" font-size: 22px, color: #1e293b
    text "We could not find anything matching your search." color: #64748b, font-size: 16px
    text "Try different keywords or filters." color: #94a3b8, font-size: 14px

    rect width: 160px, height: 44px, color: #2563eb, radius: 8px {
      text "Clear Search" color: #ffffff, font-size: 15px
      on click: navigate "/search"
    }
  }
}
