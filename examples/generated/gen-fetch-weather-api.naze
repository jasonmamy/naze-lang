-- Weather forecast from API
app "Forecast" {
  data forecast: fetch "/api/weather"

  column padding: 20px, gap: 16px {
    heading "Forecast"

    if forecast.loading {
      text "Loading forecast..." color: #64748b
    }

    if forecast.error {
      text "Failed to load forecast" color: #dc2626
    }

    if forecast.data {
      text "forecast loaded successfully" color: #16a34a
      each day in forecast.data {
        row padding: 8px, color: #fff7ed, radius: 4px {
          text "{day.summary}"
        }
      }
    }
  }
}
