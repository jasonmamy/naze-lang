-- Thai green curry recipe with coconut milk
app "Thai Green Curry" {
  state servings = 4
  state ingredients = [{name: "Chicken", amount: "500g"}, {name: "Coconut Milk", amount: "400ml"}, {name: "Green Paste", amount: "3 tbsp"}, {name: "Basil", amount: "1 cup"}]
  state current-step = 1

  column padding: 20px, gap: 16px {
    heading "Thai Green Curry"
    text "Thai | 35 min | {servings} servings" color: #64748b

    rect padding: 16px, color: #ecfdf5, radius: 8px {
      text "Ingredients" font-weight: bold, font-size: 18px
      each item in ingredients {
        text "- {item.name}: {item.amount}" color: #374151
      }
    }

    rect padding: 16px, color: #f8fafc, radius: 8px {
      text "Step {current-step}" font-weight: bold, font-size: 18px, color: #16a34a
      text "Cook paste, add chicken, pour coconut milk, simmer with basil" color: #374151
    }

    row gap: 8px {
      rect width: 100px, height: 36px, color: #16a34a, radius: 4px {
        text "Next Step" color: #ffffff
        on click: set current-step = current-step + 1
      }
      rect width: 100px, height: 36px, color: #e2e8f0, radius: 4px {
        text "Reset"
        on click: set current-step = 1
      }
    }
  }
}
