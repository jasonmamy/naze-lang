-- Daily mood tracking badges
app "Mood Tracker" {
  state status = "neutral"

  column padding: 20px, gap: 16px {
    heading "Mood Tracker"

    row gap: 8px {
      rect width: 80px, height: 28px, color: #16a34a, radius: 12px {
        text "happy" color: #ffffff, font-size: 12px
        on click: set status = "happy"
      }
      rect width: 80px, height: 28px, color: #f59e0b, radius: 12px {
        text "neutral" color: #ffffff, font-size: 12px
        on click: set status = "neutral"
      }
      rect width: 80px, height: 28px, color: #6366f1, radius: 12px {
        text "tired" color: #ffffff, font-size: 12px
        on click: set status = "tired"
      }
    }

    text "Current: {status}" font-size: 18px, font-weight: bold
  }
}
