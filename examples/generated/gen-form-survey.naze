-- Survey form with rating and comment
app "Survey" {
  state rating = ""
  state comment = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Survey"

    input bind: rating, placeholder: "Rating (1-5)"
    input bind: comment, placeholder: "Additional comments"

    rect width: 120px, height: 40px, color: #a855f7, radius: 8px {
      text "Submit" color: #ffffff
      on click: set submitted = true
    }

    if submitted {
      text "Survey submitted!" color: #16a34a
    }
  }
}
