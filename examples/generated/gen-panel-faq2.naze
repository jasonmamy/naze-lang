-- Pricing FAQ with toggle
app "FAQ Pricing" {
  state expanded = false

  column padding: 20px, gap: 16px {
    heading "FAQ Pricing"

    rect padding: 16px, color: #f8fafc, radius: 8px {
      column gap: 8px {
        row gap: 8px {
          text "Is it free?" font-weight: bold
          rect width: 70px, height: 28px, color: #16a34a, radius: 4px {
            text "Toggle" color: #ffffff, font-size: 12px
            on click: set expanded = true
          }
        }

        if expanded {
          separator
          text "Yes, Naze is open source and free." color: #334155
          text "MIT licensed for personal and commercial use." color: #64748b
          text "Community support available on GitHub." color: #94a3b8, font-size: 12px
        }
      }
    }
  }
}
