-- Team invitation form
app "Invite" {
  state invite-email = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Invite"
    text "Invite a team member" color: #64748b

    input bind: invite-email, placeholder: "colleague@work.com"

    row gap: 8px {
      rect width: 100px, height: 36px, color: #ec4899, radius: 4px {
        text "Invite" color: #ffffff
        on click: set submitted = true
      }
      rect width: 80px, height: 36px, color: #94a3b8, radius: 4px {
        text "Clear" color: #ffffff
        on click: set invite-email = ""
        on click: set submitted = false
      }
    }

    if submitted {
      rect padding: 12px, color: #fce7f3, radius: 8px {
        text "Invited: {invite-email}" font-weight: bold, color: #ec4899
      }
    }
  }
}
