-- Product size selector
app "Size Picker" {
  state choice = "medium"

  column padding: 20px, gap: 16px {
    heading "Size Picker"

    select bind: choice {
      option "Small" value: "small"
      option "Medium" value: "medium"
      option "Large" value: "large"
    }

    match choice {
      "small": rect padding: 16px, color: #f0fdf4, radius: 8px {
        text "Small: fits 5-7 oz" color: #16a34a
      }
      "medium": rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Medium: fits 8-12 oz" color: #2563eb
      }
      "large": rect padding: 16px, color: #faf5ff, radius: 8px {
        text "Large: fits 14-20 oz" color: #7c3aed
      }
      _: text "Select an option" color: #94a3b8
    }
  }
}
