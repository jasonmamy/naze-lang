-- Basketball game scoreboard with team scores
app "Basketball Score" {
  state lakers-score = 0
  state celtics-score = 0
  state period = "Q1"

  column padding: 20px, gap: 16px {
    heading "Basketball Score"
    text "{period}" color: #64748b

    grid columns: 2, gap: 16px {
      rect padding: 20px, color: #7c3aed, radius: 8px {
        text "Lakers" color: #ffffff, font-weight: bold
        text "{lakers-score}" color: #ffffff, font-size: 48px
        rect width: 80px, height: 32px, color: #ffffff, radius: 4px {
          text "+2"
          on click: set lakers-score = lakers-score + 2
        }
      }
      rect padding: 20px, color: #16a34a, radius: 8px {
        text "Celtics" color: #ffffff, font-weight: bold
        text "{celtics-score}" color: #ffffff, font-size: 48px
        rect width: 80px, height: 32px, color: #ffffff, radius: 4px {
          text "+2"
          on click: set celtics-score = celtics-score + 2
        }
      }
    }
  }
}
