-- Japanese sushi restaurant menu
app "Sushi Bar" {
  state category = "Nigiri"
  state items = [{name: "Salmon Nigiri", desc: "Fresh Atlantic salmon", price: "$6"}, {name: "Dragon Roll", desc: "Eel, avocado, cucumber", price: "$14"}, {name: "Matcha Latte", desc: "Ceremonial grade matcha", price: "$5"}]
  computed total-items = items | count

  column padding: 24px, gap: 16px {
    heading "Sushi Bar" color: #0f766e

    row gap: 8px {
      rect padding: 8px, color: #0f766e, radius: 4px {
        text "Nigiri" color: #ffffff, font-size: 13px
        on click: set category = "Nigiri"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Rolls" font-size: 13px
        on click: set category = "Rolls"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Drinks" font-size: 13px
        on click: set category = "Drinks"
      }
    }

    text "{total-items} items on the menu" color: #94a3b8, font-size: 12px

    each item in items {
      rect padding: 12px, color: #f0fdfa, radius: 8px {
        row gap: 8px {
          column gap: 2px {
            text "{item.name}" font-weight: bold
            text "{item.desc}" color: #64748b, font-size: 13px
          }
          spacer
          text "{item.price}" font-weight: bold, color: #0f766e
        }
      }
    }
  }
}
