-- Wiki with articles, categories, and recent changes
app "Wiki" {
  column padding: 20px, gap: 16px {
    heading "Wiki"
    text "Knowledge base"
    link "Articles", to: "/articles"
    link "Categories", to: "/categories"
    link "Recent", to: "/recent"
  }
}

page "/articles" {
  column padding: 20px {
    heading "Articles"
    text "Browse articles"
    link "Back to Home", to: "/"
  }
}

page "/categories" {
  column padding: 20px {
    heading "Categories"
    text "Topic categories"
    link "Back to Home", to: "/"
  }
}

page "/recent" {
  column padding: 20px {
    heading "Recent Changes"
    text "Latest edits"
    link "Back to Home", to: "/"
  }
}
