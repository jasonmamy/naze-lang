-- Email inbox statistics
app "Inbox Stats" {
  state unread = 18
  state sent = 56

  column padding: 20px, gap: 16px {
    heading "Inbox Stats"
    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #fef2f2, radius: 8px {
        text "Unread" color: #64748b, font-size: 12px
        text "{unread}" font-size: 24px, color: #ef4444
      }
      rect padding: 16px, color: #f0f9ff, radius: 8px {
        text "Sent" color: #64748b, font-size: 12px
        text "{sent}" font-size: 24px, color: #0284c7
      }
    }
    row gap: 8px {
      rect width: 80px, height: 32px, color: #ef4444, radius: 4px {
        text "+1" color: #ffffff
        on click: set unread = unread + 1
      }
      rect width: 80px, height: 32px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set unread = 18
      }
    }
  }
}
