-- Size picker with small, medium, and large options
app "Size" {
  state size = "medium"

  column padding: 20px, gap: 16px {
    heading "Size"

    match size {
      "small": text "Small selected" font-size: 14px
      "medium": text "Medium selected" font-size: 18px
      "large": text "Large selected" font-size: 24px
      _: text "Select an option" color: #64748b
    }

    row gap: 8px {
      rect width: 100px, height: 36px, color: #94a3b8, radius: 4px {
        text "small" color: #ffffff
        on click: set size = "small"
      }
      rect width: 100px, height: 36px, color: #64748b, radius: 4px {
        text "medium" color: #ffffff
        on click: set size = "medium"
      }
      rect width: 100px, height: 36px, color: #334155, radius: 4px {
        text "large" color: #ffffff
        on click: set size = "large"
      }
    }
  }
}
