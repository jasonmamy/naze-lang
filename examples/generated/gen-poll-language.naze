-- Programming language preference poll
app "Favorite Language" {
  state opt-a = 12
  state opt-b = 8
  state opt-c = 5
  computed total-votes = opt-a + opt-b + opt-c

  column padding: 24px, gap: 16px {
    heading "Favorite Language" color: #f97316
    text "Which language do you prefer?" font-size: 18px
    text "Total votes: {total-votes}" color: #64748b

    row gap: 8px {
      rect width: 120px, height: 40px, color: #f97316, radius: 8px {
        text "Rust ({opt-a})" color: #ffffff
        on click: set opt-a = opt-a + 1
      }
      rect width: 120px, height: 40px, color: #64748b, radius: 8px {
        text "Python ({opt-b})" color: #ffffff
        on click: set opt-b = opt-b + 1
      }
      rect width: 120px, height: 40px, color: #94a3b8, radius: 8px {
        text "Go ({opt-c})" color: #ffffff
        on click: set opt-c = opt-c + 1
      }
    }

    column gap: 4px {
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Rust" font-size: 12px
      }
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Python" font-size: 12px
      }
      rect width: 300px, height: 24px, color: #e2e8f0, radius: 4px {
        text "Go" font-size: 12px
      }
    }
  }
}
