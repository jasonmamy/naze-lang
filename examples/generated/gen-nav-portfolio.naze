-- Portfolio with projects, resume, and contact
app "Portfolio" {
  column padding: 20px, gap: 16px {
    heading "Portfolio"
    text "Welcome to my portfolio"
    link "Projects", to: "/projects"
    link "Resume", to: "/resume"
    link "Contact", to: "/contact"
  }
}

page "/projects" {
  column padding: 20px {
    heading "Projects"
    text "My recent work"
    link "Back to Home", to: "/"
  }
}

page "/resume" {
  column padding: 20px {
    heading "Resume"
    text "Experience and skills"
    link "Back to Home", to: "/"
  }
}

page "/contact" {
  column padding: 20px {
    heading "Contact"
    text "Get in touch"
    link "Back to Home", to: "/"
  }
}
