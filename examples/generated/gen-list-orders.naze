-- Order history sorted by status
app "Orders" {
  state items = [{item: "Laptop", status: "shipped"}, {item: "Mouse", status: "delivered"}, {item: "Monitor", status: "pending"}]
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Orders"
    text "{total} orders" color: #64748b

    each order in items | sort-by status {
      row padding: 8px, color: #fefce8, radius: 4px, gap: 8px {
        text "{order.item}" font-weight: bold
        text "{order.status}" color: #64748b
      }
    }
  }
}
