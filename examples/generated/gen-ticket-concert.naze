-- Concert event ticket display
app "Concert Ticket" {
  state ticket-id = "EVT-7720"
  state status = "Confirmed"
  state priority = "VIP"

  column padding: 24px, gap: 16px {
    heading "Concert Ticket" color: #0891b2

    rect padding: 20px, color: #ffffff, radius: 12px {
      column gap: 12px {
        row gap: 8px {
          text "Live Concert" font-weight: bold, font-size: 18px
          spacer
          rect padding: 6px, color: #ecfeff, radius: 4px {
            text "{status}" color: #0891b2, font-size: 12px
          }
        }

        separator

        row gap: 16px {
          column gap: 4px {
            text "ID" color: #94a3b8, font-size: 11px
            text "{ticket-id}" font-size: 14px
          }
          column gap: 4px {
            text "Priority" color: #94a3b8, font-size: 11px
            text "{priority}" font-size: 14px, color: #d97706
          }
          column gap: 4px {
            text "Venue" color: #94a3b8, font-size: 11px
            text "Madison Square" font-size: 14px
          }
        }

        separator

        text "The Midnight - Live Tour 2026" color: #334155
        text "Saturday, March 15 at 8:00 PM - Section A, Row 5" color: #64748b, font-size: 13px
      }
    }

    match status {
      "Confirmed": rect padding: 10px, color: #ecfeff, radius: 8px {
        text "E-ticket confirmed, show at entry" color: #0891b2, font-size: 13px
      }
      _: text "Unknown status" color: #94a3b8
    }
  }
}
