-- Notification feed from API
app "Notifications" {
  data notifs: fetch "/api/notifications"

  column padding: 20px, gap: 16px {
    heading "Notifications"

    if notifs.loading {
      text "Loading notifications..." color: #64748b
    }

    if notifs.error {
      text "Failed to load notifications" color: #dc2626
    }

    if notifs.data {
      text "notifications loaded successfully" color: #16a34a
      each notif in notifs.data {
        row padding: 8px, color: #faf5ff, radius: 4px {
          text "{notif.message}"
        }
      }
    }
  }
}
