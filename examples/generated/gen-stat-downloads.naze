-- Package download metrics
app "Package Stats" {
  state downloads = 9800
  state stars = 240

  column padding: 20px, gap: 16px {
    heading "Package Stats"
    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #ecfeff, radius: 8px {
        text "Downloads" color: #64748b, font-size: 12px
        text "{downloads}" font-size: 24px, color: #06b6d4
      }
      rect padding: 16px, color: #fef3c7, radius: 8px {
        text "Stars" color: #64748b, font-size: 12px
        text "{stars}" font-size: 24px, color: #eab308
      }
    }
    row gap: 8px {
      rect width: 80px, height: 32px, color: #06b6d4, radius: 4px {
        text "+1" color: #ffffff
        on click: set downloads = downloads + 1
      }
      rect width: 80px, height: 32px, color: #ef4444, radius: 4px {
        text "Reset" color: #ffffff
        on click: set downloads = 9800
      }
    }
  }
}
