-- Booking form with date and guests
app "Booking" {
  state date = ""
  state guests = ""
  state submitted = false

  column padding: 20px, gap: 16px {
    heading "Booking"

    input bind: date, placeholder: "Date"
    input bind: guests, placeholder: "Number of guests"

    rect width: 120px, height: 40px, color: #ec4899, radius: 8px {
      text "Book" color: #ffffff
      on click: set submitted = true
    }

    if submitted {
      text "Booking confirmed!" color: #16a34a
    }
  }
}
