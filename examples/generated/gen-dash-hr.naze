-- Human resources dashboard
app "HR Dashboard" {
  state employees = 142
  state open-roles = 8
  state reviews = 24
  state attendance = 96

  column padding: 20px, gap: 16px {
    heading "HR Dashboard"

    grid columns: 2, gap: 16px {
      rect padding: 16px, color: #eff6ff, radius: 8px {
        text "Employees" color: #64748b, font-size: 14px
        text "{employees}" font-size: 28px
      }
      rect padding: 16px, color: #fef3c7, radius: 8px {
        text "Open Roles" color: #64748b, font-size: 14px
        text "{open-roles}" font-size: 28px
      }
      rect padding: 16px, color: #fce7f3, radius: 8px {
        text "Reviews Due" color: #64748b, font-size: 14px
        text "{reviews}" font-size: 28px
      }
      rect padding: 16px, color: #ecfdf5, radius: 8px {
        text "Attendance %" color: #64748b, font-size: 14px
        text "{attendance}" font-size: 28px
      }
    }
  }
}
