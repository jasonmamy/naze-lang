-- Course listing with instructors
app "My Courses" {
  state items = [{title: "Intro to Rust", instructor: "Dr. Smith"}, {title: "Web Design", instructor: "Prof. Lee"}, {title: "Data Science", instructor: "Dr. Chen"}]
  state current = 0
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "My Courses"
    text "{current} of {total} completed" color: #16a34a

    each course in items {
      rect padding: 12px, color: #ecfdf5, radius: 8px {
        column gap: 4px {
          text "{course.title}" font-weight: bold
          text "{course.instructor}" color: #64748b
        }
      }
    }

    row gap: 8px {
      rect width: 100px, height: 36px, color: #16a34a, radius: 8px {
        text "Continue" color: #ffffff
        on click: set current = current + 1
      }
      rect width: 100px, height: 36px, color: #e2e8f0, radius: 4px {
        text "Reset"
        on click: set current = 0
      }
    }
  }
}
