-- Recipe search by name and cuisine
app "Recipe Finder" {
  state query = ""
  state items = [{name: "Pad Thai", cuisine: "Thai", time: "25min"}, {name: "Risotto", cuisine: "Italian", time: "40min"}, {name: "Tacos", cuisine: "Mexican", time: "20min"}]
  computed total = items | count

  column padding: 20px, gap: 16px {
    heading "Recipe Finder"

    row gap: 8px {
      input bind: query, placeholder: "Find a recipe..."
      rect width: 90px, height: 40px, color: #f97316, radius: 8px {
        text "Search" color: #ffffff
        on click: set query = ""
      }
    }

    text "{total} recipes" color: #64748b

    each recipe in items | sort-by name {
      rect padding: 12px, color: #fff7ed, radius: 6px {
        row gap: 12px {
          text "{recipe.name}" font-weight: bold
          text "{recipe.cuisine}" color: #64748b, font-size: 13px
          text "{recipe.time}" color: #ea580c, font-size: 12px
        }
      }
    }
  }
}
