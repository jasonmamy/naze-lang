-- Blog posts fetched from API
app "Posts" {
  data posts: fetch "/api/posts"

  column padding: 20px, gap: 16px {
    heading "Posts"

    if posts.loading {
      text "Loading posts..." color: #64748b
    }

    if posts.error {
      text "Failed to load posts" color: #dc2626
    }

    if posts.data {
      text "posts loaded successfully" color: #16a34a
      each post in posts.data {
        row padding: 8px, color: #f3f4f6, radius: 4px {
          text "{post.title}"
        }
      }
    }
  }
}
