-- Human resources KPI overview
app "HR Dashboard" {
  state headcount = 156
  state open-roles = 14
  state retention = 92
  state satisfaction = 87

  column padding: 24px, gap: 16px {
    heading "HR Dashboard" color: #0f172a

    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #eff6ff, radius: 10px {
        text "Headcount" color: #64748b, font-size: 13px
        text "{headcount}" font-size: 28px, color: #2563eb
      }
      rect padding: 16px, color: #fef3c7, radius: 10px {
        text "Open Roles" color: #64748b, font-size: 13px
        text "{open-roles}" font-size: 28px, color: #d97706
      }
      rect padding: 16px, color: #f0fdf4, radius: 10px {
        text "Retention %" color: #64748b, font-size: 13px
        text "{retention}" font-size: 28px, color: #16a34a
      }
      rect padding: 16px, color: #fdf2f8, radius: 10px {
        text "Satisfaction %" color: #64748b, font-size: 13px
        text "{satisfaction}" font-size: 28px, color: #db2777
      }
    }
  }
}
