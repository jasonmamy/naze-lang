-- Soccer match scoreboard with goal tracking
app "Soccer Score" {
  state barca-goals = 0
  state madrid-goals = 0
  state period = "1st Half"

  column padding: 20px, gap: 16px {
    heading "Soccer Score"
    text "{period}" color: #64748b

    grid columns: 2, gap: 16px {
      rect padding: 20px, color: #a21caf, radius: 8px {
        text "Barcelona" color: #ffffff, font-weight: bold
        text "{barca-goals}" color: #ffffff, font-size: 48px
        rect width: 80px, height: 32px, color: #ffffff, radius: 4px {
          text "+1"
          on click: set barca-goals = barca-goals + 1
        }
      }
      rect padding: 20px, color: #1d4ed8, radius: 8px {
        text "Real Madrid" color: #ffffff, font-weight: bold
        text "{madrid-goals}" color: #ffffff, font-size: 48px
        rect width: 80px, height: 32px, color: #ffffff, radius: 4px {
          text "+1"
          on click: set madrid-goals = madrid-goals + 1
        }
      }
    }
  }
}
