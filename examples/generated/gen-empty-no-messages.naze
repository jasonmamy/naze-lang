-- Empty inbox state with no messages
app "No Messages" {
  column padding: 40px, gap: 20px {
    spacer height: 40px

    rect width: 80px, height: 80px, color: #eff6ff, radius: 40px {
      text "@" font-size: 32px, color: #3b82f6
    }

    heading "No Messages Yet" font-size: 22px, color: #1e293b
    text "Your inbox is empty." color: #64748b, font-size: 16px
    text "Start a conversation with someone." color: #94a3b8, font-size: 14px

    rect width: 160px, height: 44px, color: #3b82f6, radius: 8px {
      text "Compose" color: #ffffff, font-size: 15px
      on click: navigate "/compose"
    }
  }
}
