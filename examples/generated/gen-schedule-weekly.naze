-- Weekly schedule with day and time slots
app "Weekly Schedule" {
  state events = [{day: "Monday", time: "09:00", activity: "Team Standup", room: "Room A"}, {day: "Tuesday", time: "14:00", activity: "Design Review", room: "Room B"}, {day: "Wednesday", time: "10:00", activity: "Sprint Planning", room: "Room C"}]
  computed event-count = events | count

  column padding: 20px, gap: 16px {
    heading "Weekly Schedule"
    text "{event-count} events this week" color: #64748b

    each evt in events | sort-by day {
      row padding: 12px, color: #eff6ff, radius: 8px, gap: 12px {
        rect width: 60px, height: 40px, color: #2563eb, radius: 4px {
          text "{evt.time}" color: #ffffff, font-size: 12px
        }
        column gap: 2px {
          text "{evt.activity}" font-weight: bold
          text "{evt.room}" color: #64748b
        }
      }
    }
  }
}
