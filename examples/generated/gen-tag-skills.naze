-- Developer skill tags with selection
app "Skills" {
  state selected-tag = ""

  column padding: 20px, gap: 16px {
    heading "Skills"
    text "Select your skills" color: #64748b

    row gap: 8px {
      rect padding: 8px, color: #dbeafe, radius: 12px {
        text "Python" color: #1e40af, font-size: 13px
        on click: set selected-tag = "Python"
      }
      rect padding: 8px, color: #fce7f3, radius: 12px {
        text "Rust" color: #9d174d, font-size: 13px
        on click: set selected-tag = "Rust"
      }
      rect padding: 8px, color: #d1fae5, radius: 12px {
        text "TypeScript" color: #065f46, font-size: 13px
        on click: set selected-tag = "TypeScript"
      }
      rect padding: 8px, color: #e0f2fe, radius: 12px {
        text "Go" color: #0369a1, font-size: 13px
        on click: set selected-tag = "Go"
      }
      rect padding: 8px, color: #fef3c7, radius: 12px {
        text "SQL" color: #92400e, font-size: 13px
        on click: set selected-tag = "SQL"
      }
    }

    if selected-tag {
      text "Selected: {selected-tag}" font-weight: bold, color: #334155
    }
  }
}
