-- Documentation site with guides and API reference
app "Docs" {
  column padding: 20px, gap: 16px {
    heading "Docs"
    text "Documentation hub"
    link "Getting Started", to: "/start"
    link "API Reference", to: "/api"
    link "Examples", to: "/examples"
  }
}

page "/start" {
  column padding: 20px {
    heading "Getting Started"
    text "Quick start guide"
    link "Back to Home", to: "/"
  }
}

page "/api" {
  column padding: 20px {
    heading "API Reference"
    text "Full API docs"
    link "Back to Home", to: "/"
  }
}

page "/examples" {
  column padding: 20px {
    heading "Examples"
    text "Code examples"
    link "Back to Home", to: "/"
  }
}
