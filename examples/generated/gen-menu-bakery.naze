-- Bakery and patisserie menu
app "Sweet Crust" {
  state category = "Bread"
  state items = [{name: "Sourdough Loaf", desc: "24-hour ferment, crusty", price: "$8"}, {name: "Chocolate Cake", desc: "Triple layer, ganache", price: "$7"}, {name: "Macarons", desc: "Assorted box of 6", price: "$12"}]
  computed total-items = items | count

  column padding: 24px, gap: 16px {
    heading "Sweet Crust" color: #9333ea

    row gap: 8px {
      rect padding: 8px, color: #9333ea, radius: 4px {
        text "Bread" color: #ffffff, font-size: 13px
        on click: set category = "Bread"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Cakes" font-size: 13px
        on click: set category = "Cakes"
      }
      rect padding: 8px, color: #e2e8f0, radius: 4px {
        text "Cookies" font-size: 13px
        on click: set category = "Cookies"
      }
    }

    text "{total-items} items on the menu" color: #94a3b8, font-size: 12px

    each item in items {
      rect padding: 12px, color: #faf5ff, radius: 8px {
        row gap: 8px {
          column gap: 2px {
            text "{item.name}" font-weight: bold
            text "{item.desc}" color: #64748b, font-size: 13px
          }
          spacer
          text "{item.price}" font-weight: bold, color: #9333ea
        }
      }
    }
  }
}
