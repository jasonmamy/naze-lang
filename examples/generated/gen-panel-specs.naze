-- Product specifications toggle
app "Specs Panel" {
  state expanded = false

  column padding: 20px, gap: 16px {
    heading "Specs Panel"

    rect padding: 16px, color: #f8fafc, radius: 8px {
      column gap: 8px {
        row gap: 8px {
          text "Technical Specifications" font-weight: bold
          rect width: 70px, height: 28px, color: #f59e0b, radius: 4px {
            text "Toggle" color: #ffffff, font-size: 12px
            on click: set expanded = true
          }
        }

        if expanded {
          separator
          text "Dimensions: 150mm x 75mm x 8mm" color: #334155
          text "Weight: 185g, Material: Aluminum" color: #64748b
          text "Battery: 4500mAh, USB-C charging" color: #94a3b8, font-size: 12px
        }
      }
    }
  }
}
