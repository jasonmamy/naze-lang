-- Rock playlist with track listing and controls
app "Rock Classics" {
  state tracks = [{title: "Bohemian Rhapsody", artist: "Queen", duration: "5:55"}, {title: "Stairway to Heaven", artist: "Led Zeppelin", duration: "8:02"}, {title: "Hotel California", artist: "Eagles", duration: "6:30"}]
  state current-track = 0
  state playing = false
  computed track-count = tracks | count

  column padding: 20px, gap: 16px {
    heading "Rock Classics"
    text "{track-count} tracks" color: #64748b

    if playing {
      text "Now Playing" color: #b45309, font-weight: bold
    }

    each track in tracks {
      row padding: 10px, color: #fef3c7, radius: 8px, gap: 8px {
        text "{track.title}" font-weight: bold
        text "{track.artist}" color: #64748b
        text "{track.duration}" color: #b45309, font-size: 12px
      }
    }

    row gap: 8px {
      rect width: 60px, height: 36px, color: #b45309, radius: 4px {
        text "Prev" color: #ffffff, font-size: 12px
        on click: set current-track = current-track - 1
      }
      rect width: 60px, height: 36px, color: #b45309, radius: 4px {
        text "Play" color: #ffffff, font-size: 12px
        on click: set playing = true
      }
      rect width: 60px, height: 36px, color: #b45309, radius: 4px {
        text "Next" color: #ffffff, font-size: 12px
        on click: set current-track = current-track + 1
      }
    }
  }
}
