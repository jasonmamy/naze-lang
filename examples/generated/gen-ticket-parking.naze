-- Parking permit ticket display
app "Parking Permit" {
  state ticket-id = "PKG-0055"
  state status = "Active"
  state priority = "Monthly"

  column padding: 24px, gap: 16px {
    heading "Parking Permit" color: #059669

    rect padding: 20px, color: #ffffff, radius: 12px {
      column gap: 12px {
        row gap: 8px {
          text "Parking Permit" font-weight: bold, font-size: 18px
          spacer
          rect padding: 6px, color: #ecfdf5, radius: 4px {
            text "{status}" color: #059669, font-size: 12px
          }
        }

        separator

        row gap: 16px {
          column gap: 4px {
            text "ID" color: #94a3b8, font-size: 11px
            text "{ticket-id}" font-size: 14px
          }
          column gap: 4px {
            text "Priority" color: #94a3b8, font-size: 11px
            text "{priority}" font-size: 14px, color: #64748b
          }
          column gap: 4px {
            text "Lot" color: #94a3b8, font-size: 11px
            text "Garage B" font-size: 14px
          }
        }

        separator

        text "Vehicle: Silver Tesla Model 3" color: #334155
        text "Valid: Jan 1 - Jan 31, 2026, Spot #127" color: #64748b, font-size: 13px
      }
    }

    match status {
      "Active": rect padding: 10px, color: #ecfdf5, radius: 8px {
        text "Permit valid, please display on dash" color: #059669, font-size: 13px
      }
      _: text "Unknown status" color: #94a3b8
    }
  }
}
