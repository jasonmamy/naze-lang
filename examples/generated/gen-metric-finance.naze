-- Financial metrics summary
app "Finance Overview" {
  state revenue = 245000
  state expenses = 178000
  state profit-margin = 27
  state runway = 18

  column padding: 24px, gap: 16px {
    heading "Finance Overview" color: #0f172a

    grid columns: 2, gap: 12px {
      rect padding: 16px, color: #f0fdf4, radius: 10px {
        text "Revenue ($)" color: #64748b, font-size: 13px
        text "{revenue}" font-size: 28px, color: #166534
      }
      rect padding: 16px, color: #fef2f2, radius: 10px {
        text "Expenses ($)" color: #64748b, font-size: 13px
        text "{expenses}" font-size: 28px, color: #dc2626
      }
      rect padding: 16px, color: #eff6ff, radius: 10px {
        text "Profit Margin %" color: #64748b, font-size: 13px
        text "{profit-margin}" font-size: 28px, color: #1e40af
      }
      rect padding: 16px, color: #fef3c7, radius: 10px {
        text "Runway (months)" color: #64748b, font-size: 13px
        text "{runway}" font-size: 28px, color: #92400e
      }
    }
  }
}
