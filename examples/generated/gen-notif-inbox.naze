-- Email inbox notification center
app "Inbox Alerts" {
  state unread = 5
  state notifications = [{title: "New message", body: "Alice sent you a message", time: "2 min ago"}, {title: "Reply received", body: "Bob replied to your thread", time: "15 min ago"}, {title: "Mention", body: "You were mentioned in a comment", time: "1 hour ago"}]
  computed total = notifications | count
  state filter = "all"

  column padding: 24px, gap: 16px {
    heading "Inbox Alerts" color: #2563eb

    row gap: 8px {
      text "Notifications" font-size: 18px, font-weight: bold
      rect padding: 4px, color: #dbeafe, radius: 10px {
        text "{unread}" color: #1d4ed8, font-size: 12px
      }
      spacer
      rect padding: 8px, color: #f1f5f9, radius: 4px {
        text "Mark all read" font-size: 12px, color: #64748b
        on click: set unread = 0
      }
    }

    row gap: 8px {
      rect padding: 6px, color: #2563eb, radius: 4px {
        text "All" color: #ffffff, font-size: 12px
        on click: set filter = "all"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Messages" font-size: 12px
        on click: set filter = "Messages"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Mentions" font-size: 12px
        on click: set filter = "Mentions"
      }
    }

    text "{total} notifications" color: #94a3b8, font-size: 12px

    each notif in notifications {
      rect padding: 12px, color: #f8fafc, radius: 8px {
        column gap: 4px {
          row gap: 8px {
            rect width: 8px, height: 8px, color: #3b82f6, radius: 4px
            text "{notif.title}" font-weight: bold, font-size: 14px
          }
          text "{notif.body}" color: #64748b, font-size: 13px
          text "{notif.time}" color: #94a3b8, font-size: 11px
        }
      }
    }
  }
}
