-- Newsletter subscription onboarding
app "Newsletter Setup" {
  state step = 1
  state name = ""
  state agreed = false

  column padding: 24px, gap: 16px {
    heading "Newsletter Setup" color: #be185d

    row gap: 8px {
      rect width: 32px, height: 32px, color: #be185d, radius: 16px {
        text "1" color: #ffffff, font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "2" font-size: 14px
      }
      rect width: 60px, height: 2px, color: #e2e8f0
      rect width: 32px, height: 32px, color: #e2e8f0, radius: 16px {
        text "3" font-size: 14px
      }
    }

    match step {
      1: column gap: 12px {
        text "Stay Informed" font-size: 20px, font-weight: bold
        text "Get curated content delivered weekly." color: #64748b
        rect width: 140px, height: 40px, color: #be185d, radius: 8px {
          text "Get Started" color: #ffffff
          on click: set step = 2
        }
      }
      2: column gap: 12px {
        text "Your Email" font-size: 20px, font-weight: bold
        text "Enter the name you want us to use." color: #64748b
        input bind: name, placeholder: "First name"
        rect width: 100px, height: 40px, color: #be185d, radius: 8px {
          text "Next" color: #ffffff
          on click: set step = 3
        }
      }
      3: column gap: 12px {
        text "Privacy Notice" font-size: 20px, font-weight: bold
        text "We respect your inbox and privacy." color: #64748b
        checkbox bind: agreed, label: "I consent to receiving emails"
        rect width: 120px, height: 40px, color: #be185d, radius: 8px {
          text "Complete" color: #ffffff
          on click: set step = 1
        }
      }
      _: text "Unknown step"
    }
  }
}
