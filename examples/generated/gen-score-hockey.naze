-- Ice hockey game scoreboard
app "Hockey Score" {
  state bruins-goals = 0
  state rangers-goals = 0
  state period = "Period 1"

  column padding: 20px, gap: 16px {
    heading "Hockey Score"
    text "{period}" color: #64748b

    grid columns: 2, gap: 16px {
      rect padding: 20px, color: #ca8a04, radius: 8px {
        text "Bruins" color: #ffffff, font-weight: bold
        text "{bruins-goals}" color: #ffffff, font-size: 48px
        rect width: 80px, height: 32px, color: #ffffff, radius: 4px {
          text "+1"
          on click: set bruins-goals = bruins-goals + 1
        }
      }
      rect padding: 20px, color: #1e40af, radius: 8px {
        text "Rangers" color: #ffffff, font-weight: bold
        text "{rangers-goals}" color: #ffffff, font-size: 48px
        rect width: 80px, height: 32px, color: #ffffff, radius: 4px {
          text "+1"
          on click: set rangers-goals = rangers-goals + 1
        }
      }
    }
  }
}
