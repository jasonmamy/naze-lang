-- Fitness app with workouts, nutrition, and progress
app "FitTrack" {
  column padding: 20px, gap: 16px {
    heading "FitTrack"
    text "Your fitness journey"
    link "Workouts", to: "/workouts"
    link "Nutrition", to: "/nutrition"
    link "Progress", to: "/progress"
  }
}

page "/workouts" {
  column padding: 20px {
    heading "Workouts"
    text "Today's exercises"
    link "Back to Home", to: "/"
  }
}

page "/nutrition" {
  column padding: 20px {
    heading "Nutrition"
    text "Meal tracking"
    link "Back to Home", to: "/"
  }
}

page "/progress" {
  column padding: 20px {
    heading "Progress"
    text "Your stats"
    link "Back to Home", to: "/"
  }
}
