-- Banking transaction notifications
app "Bank Alerts" {
  state unread = 4
  state notifications = [{title: "Payment received", body: "$250 deposit from PayCo", time: "Just now"}, {title: "Card charge", body: "$42.50 at Coffee Shop", time: "2 hours ago"}, {title: "Bill due", body: "Electric bill due in 3 days", time: "Today"}]
  computed total = notifications | count
  state filter = "all"

  column padding: 24px, gap: 16px {
    heading "Bank Alerts" color: #059669

    row gap: 8px {
      text "Notifications" font-size: 18px, font-weight: bold
      rect padding: 4px, color: #ecfdf5, radius: 10px {
        text "{unread}" color: #047857, font-size: 12px
      }
      spacer
      rect padding: 8px, color: #f1f5f9, radius: 4px {
        text "Mark all read" font-size: 12px, color: #64748b
        on click: set unread = 0
      }
    }

    row gap: 8px {
      rect padding: 6px, color: #059669, radius: 4px {
        text "All" color: #ffffff, font-size: 12px
        on click: set filter = "all"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Payments" font-size: 12px
        on click: set filter = "Payments"
      }
      rect padding: 6px, color: #e2e8f0, radius: 4px {
        text "Bills" font-size: 12px
        on click: set filter = "Bills"
      }
    }

    text "{total} notifications" color: #94a3b8, font-size: 12px

    each notif in notifications {
      rect padding: 12px, color: #f0fdf4, radius: 8px {
        column gap: 4px {
          row gap: 8px {
            rect width: 8px, height: 8px, color: #10b981, radius: 4px
            text "{notif.title}" font-weight: bold, font-size: 14px
          }
          text "{notif.body}" color: #64748b, font-size: 13px
          text "{notif.time}" color: #94a3b8, font-size: 11px
        }
      }
    }
  }
}
