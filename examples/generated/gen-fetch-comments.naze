-- Comments fetched from API
app "Comments" {
  data comments: fetch "/api/comments"

  column padding: 20px, gap: 16px {
    heading "Comments"

    if comments.loading {
      text "Loading comments..." color: #64748b
    }

    if comments.error {
      text "Failed to load comments" color: #dc2626
    }

    if comments.data {
      text "comments loaded successfully" color: #16a34a
      each comment in comments.data {
        row padding: 8px, color: #f0f9ff, radius: 4px {
          text "{comment.text}"
        }
      }
    }
  }
}
