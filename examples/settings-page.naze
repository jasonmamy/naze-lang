-- Settings page with persistent storage
app "Settings" {
  storage font-size-pref: local "font-size" default: "16"
  storage notifications: local "notifications" default: "on"
  state saved = false

  column padding: 20px, gap: 16px {
    heading "Settings"

    column gap: 8px {
      text "Font Size"
      input bind: font-size-pref, placeholder: "Font size in px"
    }

    column gap: 8px {
      text "Notifications"
      select bind: notifications {
        option "On" value: "on"
        option "Off" value: "off"
      }
    }

    rect width: 120px, height: 40px, color: #2563eb, radius: 8px {
      text "Save" color: #ffffff
      on click: set saved = true
    }

    if saved {
      text "Settings saved!" color: #16a34a
    }
  }
}
