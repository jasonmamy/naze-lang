-- Rounded rectangles with varying radii
app "Rounded" {
  column padding: 20px, gap: 12px {
    heading "Corner Radii"
    row gap: 12px {
      rect width: 80px, height: 80px, color: #8b5cf6, radius: 0px
      rect width: 80px, height: 80px, color: #8b5cf6, radius: 8px
      rect width: 80px, height: 80px, color: #8b5cf6, radius: 16px
      rect width: 80px, height: 80px, color: #8b5cf6, radius: 40px
    }
  }
}
