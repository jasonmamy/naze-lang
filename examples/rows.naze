-- Horizontal layout
app "Rows" {
  column padding: 20px, gap: 16px {
    heading "Horizontal Items"
    row gap: 12px {
      rect width: 60px, height: 60px, color: #ef4444
      rect width: 60px, height: 60px, color: #f97316
      rect width: 60px, height: 60px, color: #eab308
      rect width: 60px, height: 60px, color: #22c55e
      rect width: 60px, height: 60px, color: #3b82f6
    }
  }
}
