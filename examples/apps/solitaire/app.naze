-- Klondike Solitaire: card objects, each-binding, match, conditional actions, pipelines
app "Klondike Solitaire" {
  -- Tableau piles (7 piles, all face-up)
  state t0 = [{r: 7, s: 1}]
  state t1 = [{r: 3, s: 0}, {r: 12, s: 3}]
  state t2 = [{r: 5, s: 2}, {r: 10, s: 1}, {r: 2, s: 0}]
  state t3 = [{r: 13, s: 3}, {r: 8, s: 0}, {r: 4, s: 1}, {r: 11, s: 2}]
  state t4 = [{r: 6, s: 1}, {r: 9, s: 2}, {r: 1, s: 0}, {r: 3, s: 3}, {r: 7, s: 0}]
  state t5 = [{r: 11, s: 0}, {r: 2, s: 3}, {r: 8, s: 1}, {r: 4, s: 2}, {r: 10, s: 0}, {r: 6, s: 3}]
  state t6 = [{r: 9, s: 1}, {r: 1, s: 2}, {r: 5, s: 0}, {r: 12, s: 1}, {r: 3, s: 2}, {r: 8, s: 3}, {r: 13, s: 0}]

  -- Stock and waste
  state stock = [{r: 1, s: 1}, {r: 2, s: 1}, {r: 4, s: 0}, {r: 5, s: 3}, {r: 6, s: 0}, {r: 6, s: 2}, {r: 7, s: 2}, {r: 7, s: 3}, {r: 8, s: 2}, {r: 9, s: 0}, {r: 9, s: 3}, {r: 10, s: 2}, {r: 10, s: 3}, {r: 11, s: 1}, {r: 11, s: 3}, {r: 12, s: 0}, {r: 12, s: 2}, {r: 13, s: 1}, {r: 13, s: 2}, {r: 1, s: 3}, {r: 2, s: 2}, {r: 3, s: 1}, {r: 4, s: 3}, {r: 5, s: 1}]
  state waste = []

  -- Foundation counters (next card rank to accept, 0 = empty, accepts rank 1 first)
  state f0 = 0
  state f1 = 0
  state f2 = 0
  state f3 = 0

  -- Selection state
  state sel = -1
  state selr = 0
  state sels = 0

  -- Game state
  state moves = 0
  state msg = ""

  -- Top card tracking via computed
  computed t0len = length(t0)
  computed t1len = length(t1)
  computed t2len = length(t2)
  computed t3len = length(t3)
  computed t4len = length(t4)
  computed t5len = length(t5)
  computed t6len = length(t6)
  computed wlen = length(waste)
  computed slen = length(stock)
  computed won = f0 + f1 + f2 + f3

  column gap: 0px, width: 100%, height: 100%, color: #0a3622 {
    -- Header bar
    container color: #14532d, padding: 16px {
      row gap: 16px, align: center {
        heading "Solitaire" color: #ffffff, font-size: 24px
        text "Moves: {moves}" color: #86efac, font-size: 14px
        text "Score: {won}/52" color: #86efac, font-size: 14px

        if sel != -1 {
          rect padding: 8px, color: #22c55e, radius: 4px {
            text "Card selected" color: #ffffff, font-size: 12px
          }
        }

        if won == 52 {
          text "YOU WIN!" color: #fbbf24, font-size: 20px, font-weight: bold
        }
      }
    }

    column padding: 16px, gap: 16px, flex-grow: 1 {
      -- Top row: stock, waste, foundations
      row gap: 8px {
        -- Stock pile
        column flex-grow: 1 {
          rect width: 100%, height: 140px, color: #166534, radius: 6px, role: "button", label: "Stock" {
            on click: if slen > 0 { append stock[slen - 1] to waste, remove slen - 1 from stock }
            column align: center, justify: center {
              if slen > 0 {
                text "{slen}" color: #ffffff, font-size: 16px, font-weight: bold
              }
              if slen == 0 {
                text "-" color: #4ade80, font-size: 20px
              }
            }
          }
        }

        -- Waste pile (click any card to select it)
        column flex-grow: 1 {
          rect width: 100%, height: 50px, color: #064e3b, radius: 6px {
            column align: center, justify: center {
              if wlen == 0 {
                text "-" color: #4ade80, font-size: 16px
              }
              if wlen > 0 {
                text "W" color: #86efac, font-size: 10px
              }
            }
          }
          column gap: -30px {
            each card in waste {
              rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Waste card" {
                on click: if sel == -1 { set sel = 7, set selr = card.r, set sels = card.s }
                row align: center, gap: 2px {
                  match card.s {
                    0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                    1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                    2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                    _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                  }
                  match card.r {
                    1: text "A" color: #334155, font-size: 16px
                    11: text "J" color: #334155, font-size: 16px
                    12: text "Q" color: #334155, font-size: 16px
                    13: text "K" color: #334155, font-size: 16px
                    _: text "{card.r}" color: #334155, font-size: 16px
                  }
                }
              }
            }
          }
        }

        -- Spacer pushes foundations to the right
        spacer

        -- Foundation 0 (spades)
        column flex-grow: 1 {
          rect width: 100%, height: 140px, color: #1e3a5f, radius: 6px, role: "button", label: "Foundation Spades" {
            on click: if sel != -1 && sels == 0 && selr == f0 + 1 { set f0 = f0 + 1, set msg = "moved" }
            column align: center, justify: center {
              if f0 > 0 {
                text "{f0}" color: #ffffff, font-size: 20px, font-weight: bold
              }
              if f0 == 0 {
                text "♠" color: #64748b, font-size: 20px
              }
            }
          }
        }

        -- Foundation 1 (hearts)
        column flex-grow: 1 {
          rect width: 100%, height: 140px, color: #5f1e1e, radius: 6px, role: "button", label: "Foundation Hearts" {
            on click: if sel != -1 && sels == 1 && selr == f1 + 1 { set f1 = f1 + 1, set msg = "moved" }
            column align: center, justify: center {
              if f1 > 0 {
                text "{f1}" color: #fca5a5, font-size: 20px, font-weight: bold
              }
              if f1 == 0 {
                text "♥" color: #64748b, font-size: 20px
              }
            }
          }
        }

        -- Foundation 2 (clubs)
        column flex-grow: 1 {
          rect width: 100%, height: 140px, color: #1e3a5f, radius: 6px, role: "button", label: "Foundation Clubs" {
            on click: if sel != -1 && sels == 2 && selr == f2 + 1 { set f2 = f2 + 1, set msg = "moved" }
            column align: center, justify: center {
              if f2 > 0 {
                text "{f2}" color: #ffffff, font-size: 20px, font-weight: bold
              }
              if f2 == 0 {
                text "♣" color: #64748b, font-size: 20px
              }
            }
          }
        }

        -- Foundation 3 (diamonds)
        column flex-grow: 1 {
          rect width: 100%, height: 140px, color: #5f1e1e, radius: 6px, role: "button", label: "Foundation Diamonds" {
            on click: if sel != -1 && sels == 3 && selr == f3 + 1 { set f3 = f3 + 1, set msg = "moved" }
            column align: center, justify: center {
              if f3 > 0 {
                text "{f3}" color: #fca5a5, font-size: 20px, font-weight: bold
              }
              if f3 == 0 {
                text "♦" color: #64748b, font-size: 20px
              }
            }
          }
        }
      }

      -- Source removal: after a "moved" message, remove from source pile
      -- This is triggered by clicking a destination after a card was moved to foundation
      on click: if msg == "moved" && sel == 0 { remove t0len - 1 from t0, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }
      on click: if msg == "moved" && sel == 1 { remove t1len - 1 from t1, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }
      on click: if msg == "moved" && sel == 2 { remove t2len - 1 from t2, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }
      on click: if msg == "moved" && sel == 3 { remove t3len - 1 from t3, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }
      on click: if msg == "moved" && sel == 4 { remove t4len - 1 from t4, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }
      on click: if msg == "moved" && sel == 5 { remove t5len - 1 from t5, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }
      on click: if msg == "moved" && sel == 6 { remove t6len - 1 from t6, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }
      on click: if msg == "moved" && sel == 7 { remove wlen - 1 from waste, set sel = -1, set selr = 0, set sels = 0, set moves = moves + 1, set msg = "" }

      -- Tableau
      row gap: 8px {
        -- Pile 0
        column gap: 2px, flex-grow: 1 {
          text "P1" color: #64748b, font-size: 10px
          rect width: 100%, height: 140px, color: #1e293b, radius: 6px, role: "button", label: "Pile 1" {
            on click: if sel != -1 && sel != 0 && t0len == 0 && selr == 13 { append {r: selr, s: sels} to t0, set msg = "moved" }
            column align: center, justify: center {
              if t0len == 0 {
                text "-" color: #475569, font-size: 28px
              }
            }
          }
          each card in t0 {
            rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Card" {
              on click: if sel == -1 { set sel = 0, set selr = card.r, set sels = card.s }
              on click: if sel != -1 && sel != 0 && t0len > 0 { append {r: selr, s: sels} to t0, set msg = "moved" }
              row align: center, gap: 2px {
                match card.s {
                  0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                  2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                }
                match card.r {
                  1: text "A" color: #334155, font-size: 16px
                  11: text "J" color: #334155, font-size: 16px
                  12: text "Q" color: #334155, font-size: 16px
                  13: text "K" color: #334155, font-size: 16px
                  _: text "{card.r}" color: #334155, font-size: 16px
                }
              }
            }
          }
        }

        -- Pile 1
        column gap: 2px, flex-grow: 1 {
          text "P2" color: #64748b, font-size: 10px
          rect width: 100%, height: 140px, color: #1e293b, radius: 6px, role: "button", label: "Pile 2" {
            on click: if sel != -1 && sel != 1 && t1len == 0 && selr == 13 { append {r: selr, s: sels} to t1, set msg = "moved" }
            column align: center, justify: center {
              if t1len == 0 {
                text "-" color: #475569, font-size: 28px
              }
            }
          }
          each card in t1 {
            rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Card" {
              on click: if sel == -1 { set sel = 1, set selr = card.r, set sels = card.s }
              on click: if sel != -1 && sel != 1 && t1len > 0 { append {r: selr, s: sels} to t1, set msg = "moved" }
              row align: center, gap: 2px {
                match card.s {
                  0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                  2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                }
                match card.r {
                  1: text "A" color: #334155, font-size: 16px
                  11: text "J" color: #334155, font-size: 16px
                  12: text "Q" color: #334155, font-size: 16px
                  13: text "K" color: #334155, font-size: 16px
                  _: text "{card.r}" color: #334155, font-size: 16px
                }
              }
            }
          }
        }

        -- Pile 2
        column gap: 2px, flex-grow: 1 {
          text "P3" color: #64748b, font-size: 10px
          rect width: 100%, height: 140px, color: #1e293b, radius: 6px, role: "button", label: "Pile 3" {
            on click: if sel != -1 && sel != 2 && t2len == 0 && selr == 13 { append {r: selr, s: sels} to t2, set msg = "moved" }
            column align: center, justify: center {
              if t2len == 0 {
                text "-" color: #475569, font-size: 28px
              }
            }
          }
          each card in t2 {
            rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Card" {
              on click: if sel == -1 { set sel = 2, set selr = card.r, set sels = card.s }
              on click: if sel != -1 && sel != 2 && t2len > 0 { append {r: selr, s: sels} to t2, set msg = "moved" }
              row align: center, gap: 2px {
                match card.s {
                  0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                  2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                }
                match card.r {
                  1: text "A" color: #334155, font-size: 16px
                  11: text "J" color: #334155, font-size: 16px
                  12: text "Q" color: #334155, font-size: 16px
                  13: text "K" color: #334155, font-size: 16px
                  _: text "{card.r}" color: #334155, font-size: 16px
                }
              }
            }
          }
        }

        -- Pile 3
        column gap: 2px, flex-grow: 1 {
          text "P4" color: #64748b, font-size: 10px
          rect width: 100%, height: 140px, color: #1e293b, radius: 6px, role: "button", label: "Pile 4" {
            on click: if sel != -1 && sel != 3 && t3len == 0 && selr == 13 { append {r: selr, s: sels} to t3, set msg = "moved" }
            column align: center, justify: center {
              if t3len == 0 {
                text "-" color: #475569, font-size: 28px
              }
            }
          }
          each card in t3 {
            rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Card" {
              on click: if sel == -1 { set sel = 3, set selr = card.r, set sels = card.s }
              on click: if sel != -1 && sel != 3 && t3len > 0 { append {r: selr, s: sels} to t3, set msg = "moved" }
              row align: center, gap: 2px {
                match card.s {
                  0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                  2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                }
                match card.r {
                  1: text "A" color: #334155, font-size: 16px
                  11: text "J" color: #334155, font-size: 16px
                  12: text "Q" color: #334155, font-size: 16px
                  13: text "K" color: #334155, font-size: 16px
                  _: text "{card.r}" color: #334155, font-size: 16px
                }
              }
            }
          }
        }

        -- Pile 4
        column gap: 2px, flex-grow: 1 {
          text "P5" color: #64748b, font-size: 10px
          rect width: 100%, height: 140px, color: #1e293b, radius: 6px, role: "button", label: "Pile 5" {
            on click: if sel != -1 && sel != 4 && t4len == 0 && selr == 13 { append {r: selr, s: sels} to t4, set msg = "moved" }
            column align: center, justify: center {
              if t4len == 0 {
                text "-" color: #475569, font-size: 28px
              }
            }
          }
          each card in t4 {
            rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Card" {
              on click: if sel == -1 { set sel = 4, set selr = card.r, set sels = card.s }
              on click: if sel != -1 && sel != 4 && t4len > 0 { append {r: selr, s: sels} to t4, set msg = "moved" }
              row align: center, gap: 2px {
                match card.s {
                  0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                  2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                }
                match card.r {
                  1: text "A" color: #334155, font-size: 16px
                  11: text "J" color: #334155, font-size: 16px
                  12: text "Q" color: #334155, font-size: 16px
                  13: text "K" color: #334155, font-size: 16px
                  _: text "{card.r}" color: #334155, font-size: 16px
                }
              }
            }
          }
        }

        -- Pile 5
        column gap: 2px, flex-grow: 1 {
          text "P6" color: #64748b, font-size: 10px
          rect width: 100%, height: 140px, color: #1e293b, radius: 6px, role: "button", label: "Pile 6" {
            on click: if sel != -1 && sel != 5 && t5len == 0 && selr == 13 { append {r: selr, s: sels} to t5, set msg = "moved" }
            column align: center, justify: center {
              if t5len == 0 {
                text "-" color: #475569, font-size: 28px
              }
            }
          }
          each card in t5 {
            rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Card" {
              on click: if sel == -1 { set sel = 5, set selr = card.r, set sels = card.s }
              on click: if sel != -1 && sel != 5 && t5len > 0 { append {r: selr, s: sels} to t5, set msg = "moved" }
              row align: center, gap: 2px {
                match card.s {
                  0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                  2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                }
                match card.r {
                  1: text "A" color: #334155, font-size: 16px
                  11: text "J" color: #334155, font-size: 16px
                  12: text "Q" color: #334155, font-size: 16px
                  13: text "K" color: #334155, font-size: 16px
                  _: text "{card.r}" color: #334155, font-size: 16px
                }
              }
            }
          }
        }

        -- Pile 6
        column gap: 2px, flex-grow: 1 {
          text "P7" color: #64748b, font-size: 10px
          rect width: 100%, height: 140px, color: #1e293b, radius: 6px, role: "button", label: "Pile 7" {
            on click: if sel != -1 && sel != 6 && t6len == 0 && selr == 13 { append {r: selr, s: sels} to t6, set msg = "moved" }
            column align: center, justify: center {
              if t6len == 0 {
                text "-" color: #475569, font-size: 28px
              }
            }
          }
          each card in t6 {
            rect width: 100%, height: 48px, color: #ffffff, radius: 3px, border: 1px, border-color: #000000, role: "button", label: "Card" {
              on click: if sel == -1 { set sel = 6, set selr = card.r, set sels = card.s }
              on click: if sel != -1 && sel != 6 && t6len > 0 { append {r: selr, s: sels} to t6, set msg = "moved" }
              row align: center, gap: 2px {
                match card.s {
                  0: path d: "M6 1 C3 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 9 3 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  1: path d: "M6 2 C3 0 0 3 0 5 C0 9 6 11 6 11 C6 11 12 9 12 5 C12 3 9 0 6 2Z", fill: #dc2626, width: 18px, height: 18px
                  2: path d: "M6 1 C4 1 3 3 4 4 C2 3 0 5 0 7 C0 9 2 10 4 9 L4 11 L8 11 L8 9 C10 10 12 9 12 7 C12 5 10 3 8 4 C9 3 8 1 6 1Z", fill: #1e293b, width: 18px, height: 18px
                  _: path d: "M6 0 L12 6 L6 12 L0 6Z", fill: #dc2626, width: 18px, height: 18px
                }
                match card.r {
                  1: text "A" color: #334155, font-size: 16px
                  11: text "J" color: #334155, font-size: 16px
                  12: text "Q" color: #334155, font-size: 16px
                  13: text "K" color: #334155, font-size: 16px
                  _: text "{card.r}" color: #334155, font-size: 16px
                }
              }
            }
          }
        }
      }

      -- Deselect button
      if sel != -1 {
        rect padding: 12px, color: #dc2626, radius: 6px, role: "button", label: "Cancel selection" {
          on click: set sel = -1, set selr = 0, set sels = 0, set msg = ""
          column align: center, justify: center {
            text "Cancel" color: #ffffff, font-size: 14px
          }
        }
      }

      -- New game button
      rect padding: 12px, color: #2563eb, radius: 6px, role: "button", label: "New Game" {
        on click: set stock = stock | shuffle
        on click: set sel = -1, set selr = 0, set sels = 0, set msg = "", set moves = 0
        on click: set f0 = 0, set f1 = 0, set f2 = 0, set f3 = 0
        column align: center, justify: center {
          text "Shuffle Stock" color: #ffffff, font-size: 14px
        }
      }
    }
  }
}
